{# Plain inline-styled HTML, not a Tailwind/DaisyUI-class page - email
   clients don't load assets/styles/app.css, so none of the usual
   component classes render here. Kept deliberately minimal. #}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <title>{{ 'mail.streak_reminder.subject'|trans({'%streak%': streak}) }}</title>
</head>
<body style="margin:0;padding:0;background-color:#f4f4f2;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;color:#1f2420;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="padding:32px 16px;">
        <tr>
            <td align="center">
                <table role="presentation" width="100%" style="max-width:480px;background-color:#ffffff;border-radius:12px;padding:32px;">
                    <tr>
                        <td>
                            <p style="margin:0 0 16px;font-size:14px;letter-spacing:0.05em;text-transform:uppercase;color:#6b7169;">Guitorial</p>
                            <h1 style="margin:0 0 16px;font-size:22px;line-height:1.3;">{{ 'mail.streak_reminder.heading'|trans({'%streak%': streak}) }}</h1>
                            <p style="margin:0 0 24px;font-size:15px;line-height:1.6;color:#3a3f39;">{{ 'mail.streak_reminder.body'|trans({'%firstName%': firstName}) }}</p>
                            <p style="margin:0 0 32px;">
                                <a href="{{ diaryUrl }}" style="display:inline-block;background-color:#3f7d4f;color:#ffffff;text-decoration:none;padding:12px 24px;border-radius:8px;font-size:15px;">{{ 'mail.streak_reminder.cta'|trans }}</a>
                            </p>
                            <p style="margin:0;font-size:12px;line-height:1.5;color:#8a8f87;">
                                {{ 'mail.streak_reminder.unsubscribe_hint'|trans }}
                                <a href="{{ unsubscribeUrl }}" style="color:#8a8f87;">{{ 'mail.streak_reminder.unsubscribe_link'|trans }}</a>
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
