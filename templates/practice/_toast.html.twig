{#
    Expects `toast`: {correct: bool, guessLabel: string, answerLabel: string}|null

    Solid success/error fill + its paired -content text color (not a
    translucent success/10-ish wash over text-base-content) - the same
    low-opacity-tint problem _frame_toast.html.twig's own comment already
    documents (barely visible in guitorial-dark) applies here too, just
    never fixed for this toast until now.
#}
{% if toast %}
    <div
            class="fixed inset-x-0 top-0 z-50 flex justify-center pointer-events-none transition-opacity duration-300 sm:top-4"
            data-controller="toast"
    >
        <div class="animate-[toast-in_0.2s_ease-out] flex w-full items-center gap-3 px-4 py-3 shadow-xl sm:w-auto sm:rounded-box sm:px-5 sm:py-3.5 {{ toast.correct ? 'bg-success text-success-content' : 'bg-error text-error-content' }}">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-current/15">
                {% if toast.correct %}
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {% else %}
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {% endif %}
            </span>

            {% if toast.correct %}
                <span class="font-mono text-base font-semibold sm:text-lg">
                    <span class="sr-only">{{ 'practice_toast.correct'|trans }}: </span>{{ toast.answerLabel }}
                </span>
            {% else %}
                <span class="flex flex-wrap items-baseline gap-x-2 font-mono text-base sm:text-lg">
                    <span class="sr-only">{{ 'practice_toast.chosen'|trans }}: {{ toast.guessLabel }}. {{ 'practice_toast.correct'|trans }}: </span>
                    <span class="opacity-70 line-through" aria-hidden="true">{{ toast.guessLabel }}</span>
                    <span class="opacity-50" aria-hidden="true">&rarr;</span>
                    <span class="font-semibold">{{ toast.answerLabel }}</span>
                </span>
            {% endif %}
        </div>
    </div>
{% endif %}
