{# Expects `toast`: {correct: bool, guessLabel: string, answerLabel: string}|null #}
{% if toast %}
    <div
            class="toast toast-top toast-center z-50 pointer-events-none transition-opacity duration-300"
            data-controller="toast"
    >
        <div class="animate-[toast-in_0.2s_ease-out] flex items-center gap-3 rounded-box border border-base-300 bg-base-100/95 px-4 py-3 shadow-xl backdrop-blur sm:px-5 sm:py-3.5">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full {{ toast.correct ? 'bg-success/15 text-success' : 'bg-error/15 text-error' }}">
                {% if toast.correct %}
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {% else %}
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {% endif %}
            </span>

            {% if toast.correct %}
                <span class="font-mono text-base font-semibold text-base-content sm:text-lg">
                    <span class="sr-only">{{ 'practice_toast.correct'|trans }}: </span>{{ toast.answerLabel }}
                </span>
            {% else %}
                <span class="flex flex-wrap items-baseline gap-x-2 font-mono text-base sm:text-lg">
                    <span class="sr-only">{{ 'practice_toast.chosen'|trans }}: {{ toast.guessLabel }}. {{ 'practice_toast.correct'|trans }}: </span>
                    <span class="text-base-content/60 line-through" aria-hidden="true">{{ toast.guessLabel }}</span>
                    <span class="text-base-content/40" aria-hidden="true">&rarr;</span>
                    <span class="font-semibold text-base-content">{{ toast.answerLabel }}</span>
                </span>
            {% endif %}
        </div>
    </div>
{% endif %}
