{# Expects `records`: {points, timeBonusPoints, bestPoints, isNewRecord}|null #}
{% if records %}
    <p class="mt-2 font-mono text-sm text-base-content/70">
        {{ 'practice_records.points'|trans({'%points%': records.points}) }}
        {% if records.timeBonusPoints > 0 %}
            <span class="text-base-content/50">({{ 'practice_records.time_bonus'|trans({'%bonus%': records.timeBonusPoints}) }})</span>
        {% endif %}
    </p>
    {% if records.isNewRecord %}
        <p class="mt-1 text-xs font-semibold text-primary">{{ 'practice_records.new_record'|trans }}</p>
    {% else %}
        <p class="mt-1 text-xs text-base-content/50">{{ 'practice_records.best'|trans({'%points%': records.bestPoints}) }}</p>
    {% endif %}
{% endif %}
