{% extends 'base.html.twig' %}
{% import '_components/icons.html.twig' as icons %}

{% block title %}{{ 'legal.privacy.title'|trans }} – Guitorial{% endblock %}
{% block meta_description %}{{ 'legal.privacy.meta_description'|trans }}{% endblock %}

{% block body %}
    <a href="{{ path('training_index') }}" class="inline-flex items-center gap-1 text-sm text-base-content/70 hover:text-primary">
        {{ icons.icon('back') }}
        {{ 'nav.back_home'|trans }}
    </a>

    <h1 class="font-display mt-3 text-2xl font-semibold sm:text-3xl">{{ 'legal.privacy.title'|trans }}</h1>

    <section class="mt-8">
        <h2 class="font-display text-lg font-semibold">{{ 'legal.privacy.controller.title'|trans }}</h2>
        <p class="mt-2 whitespace-pre-line text-base-content/70">{{ 'legal.privacy.controller.body'|trans }}</p>
    </section>

    <section class="mt-8">
        <h2 class="font-display text-lg font-semibold">{{ 'legal.privacy.cookies.title'|trans }}</h2>
        <p class="mt-2 text-base-content/70">{{ 'legal.privacy.cookies.body'|trans }}</p>
    </section>

    <section class="mt-8">
        <h2 class="font-display text-lg font-semibold">{{ 'legal.privacy.account.title'|trans }}</h2>
        <p class="mt-2 text-base-content/70">{{ 'legal.privacy.account.body'|trans }}</p>
    </section>

    <section class="mt-8">
        <h2 class="font-display text-lg font-semibold">{{ 'legal.privacy.data.title'|trans }}</h2>
        <p class="mt-2 text-base-content/70">{{ 'legal.privacy.data.body'|trans }}</p>
    </section>

    <section class="mt-8">
        <h2 class="font-display text-lg font-semibold">{{ 'legal.privacy.fonts.title'|trans }}</h2>
        <p class="mt-2 text-base-content/70">{{ 'legal.privacy.fonts.body'|trans }}</p>
    </section>

    <section class="mt-8">
        <h2 class="font-display text-lg font-semibold">{{ 'legal.privacy.no_tracking.title'|trans }}</h2>
        <p class="mt-2 text-base-content/70">{{ 'legal.privacy.no_tracking.body'|trans }}</p>
    </section>

    <section class="mt-8">
        <h2 class="font-display text-lg font-semibold">{{ 'legal.privacy.rights.title'|trans }}</h2>
        <p class="mt-2 whitespace-pre-line text-base-content/70">{{ 'legal.privacy.rights.body'|trans }}</p>
    </section>
{% endblock %}
