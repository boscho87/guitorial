{% extends 'base.html.twig' %}
{% import '_components/confirm_modal.html.twig' as confirmModal %}
{% import '_components/icons.html.twig' as icons %}

{% block title %}{{ 'exercise_session.title'|trans }} – Guitorial{% endblock %}

{# The elapsed-time clock is only correct as of the moment this page was
   rendered (see ExerciseSessionController::running() /
   creditableSecondsElapsed()) - Turbo Drive's page cache would otherwise
   instantly restore a stale snapshot (with the old, pre-departure clock
   anchor still ticking away client-side) when navigating back here,
   completely bypassing that server-side recalculation. Forces a fresh
   fetch every time instead of ever serving this page from cache. #}
{% block head_extra %}<meta name="turbo-cache-control" content="no-cache">{% endblock %}

{% block body %}
    <a href="{{ returnRouteId ? path('routine_show', {id: returnRouteId}) : path('diary_index') }}" class="inline-flex items-center gap-1 text-sm text-base-content/70 hover:text-primary">
        {{ icons.icon('back') }}
        {{ 'nav.diary'|trans }}
    </a>

    <h1 class="font-display mt-3 text-2xl font-semibold sm:text-3xl">{{ title ?? 'exercise_session.untitled'|trans }}</h1>

    <div
            class="stat-tile mt-8 flex flex-col items-center gap-2 py-10 text-center"
            data-controller="session-heartbeat timer"
            data-session-heartbeat-url-value="{{ path('exercise_session_heartbeat', {id: session.id}) }}"
            data-session-heartbeat-token-value="{{ csrf_token(csrfIntention) }}"
            data-action="timer:pause->session-heartbeat#pauseForCheckin timer:resume->session-heartbeat#resumeFromCheckin"
            data-timer-start-value="{{ startedAtMs }}"
            data-timer-pause-when-hidden-value="true"
            {% if targetSeconds %}
                data-timer-target-seconds-value="{{ targetSeconds }}"
                {# Once overtime starts, check in every 10 minutes that
                   someone's still actually there - a tab can stay open and
                   visible, heartbeats still firing, long after someone
                   walked away, which the hidden-tab pause above never
                   catches on its own. #}
                data-timer-checkin-interval-minutes-value="10"
                data-timer-checkin-flash-title-value="{{ 'exercise_session.checkin.flash_title'|trans }}"
                data-timer-checkin-notification-body-value="{{ 'exercise_session.checkin.notification_body'|trans }}"
            {% endif %}
    >
        {# Wall-clock elapsed time (never a JS countdown) - anchored on the
           session's creditable elapsed time (see creditableSecondsElapsed()),
           not raw startedAt, so a fresh page load after time away doesn't
           look like it kept running. data-timer-pause-when-hidden-value
           additionally freezes the display itself while this tab/app isn't
           the visible one - switching away without ever navigating out of
           Guitorial triggers no request at all, so nothing server-side ever
           gets a chance to recompute anything. #}
        <span class="font-mono text-5xl font-semibold text-primary" data-timer-target="clock">0:00</span>
        {% if targetSeconds %}
            <p class="text-xs text-base-content/60">{{ 'exercise_session.target'|trans({'%minutes%': (targetSeconds / 60)|round}) }}</p>
            {# Same warm-to-cool sweep as the diary card's gradient bar, plus
               a brief "pulse" every full minute (see timer_controller.js) -
               live progress toward today's target while it's still ticking,
               not just the static number above. #}
            <div class="h-1.5 w-40 max-w-full overflow-hidden rounded-full bg-base-300">
                <div class="h-full rounded-full transition-[width,background-color] duration-700 ease-out" data-timer-target="bar" style="width: 0%; background-color: hsl(30 75% 48%);"></div>
            </div>
            {# No backdrop click-to-close, and Escape is explicitly blocked
               (cancel->timer#preventCancel) - the whole point is requiring
               the actual confirm click, not just any dismissal. #}
            <dialog class="modal" data-timer-target="checkinDialog" data-action="cancel->timer#preventCancel">
                <div class="modal-box">
                    <p class="text-base font-semibold">{{ 'exercise_session.checkin.title'|trans }}</p>
                    <p class="mt-2 text-sm text-base-content/70">{{ 'exercise_session.checkin.message'|trans }}</p>
                    <div class="modal-action">
                        <button type="button" class="btn btn-primary" data-action="timer#confirmCheckin">{{ 'exercise_session.checkin.confirm'|trans }}</button>
                    </div>
                </div>
            </dialog>
        {% endif %}
    </div>

    {% if previousNote %}
        <div class="stat-tile mt-4">
            <p class="eyebrow">{{ 'exercise_session.previous_note.label'|trans({'%date%': previousNoteDate|date('d.m.Y')}) }}</p>
            <p class="mt-1 text-sm text-base-content/80">{{ previousNote }}</p>
        </div>
    {% endif %}

    {% if resource and not resource.isInternalTool %}
        <div class="mt-6">
            {% if youtubeVideoIds[resource.id] is defined %}
                {{ include('exercise_session/_youtube_player.html.twig', {resource: resource, videoId: youtubeVideoIds[resource.id]}) }}
            {% else %}
                <a href="{{ resource.externalUrl }}" target="_blank" rel="noopener" class="btn btn-outline btn-block">
                    <span class="min-w-0 truncate">{{ 'exercise_session.reopen_resource'|trans }} ({{ resource.externalTitle ?? resource.externalProvider ?? resource.externalUrl }})</span>
                </a>
            {% endif %}
        </div>
    {% elseif openableResources is not empty %}
        <div class="mt-6 flex flex-col gap-2">
            {% for openableResource in openableResources %}
                {% if youtubeVideoIds[openableResource.id] is defined %}
                    {{ include('exercise_session/_youtube_player.html.twig', {resource: openableResource, videoId: youtubeVideoIds[openableResource.id]}) }}
                {% else %}
                    <a href="{{ openableResource.externalUrl }}" target="_blank" rel="noopener" class="btn btn-outline btn-block">
                        <span class="min-w-0 truncate">{{ 'exercise_session.reopen_resource'|trans }} ({{ openableResource.externalTitle ?? openableResource.externalProvider ?? openableResource.externalUrl }})</span>
                    </a>
                {% endif %}
            {% endfor %}
        </div>
    {% endif %}

    <div class="mt-8">
        <h2 class="eyebrow">{{ 'exercise_session.finish.title'|trans }}</h2>
        <form method="post" action="{{ path('exercise_session_finish', {id: session.id}) }}" class="mt-3" data-controller="submit-loading" data-action="submit->submit-loading#submit">
            <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">
            {% if returnRouteId %}
                <input type="hidden" name="return_route" value="routine_show">
                <input type="hidden" name="return_route_id" value="{{ returnRouteId }}">
            {% endif %}
            <div class="grid grid-cols-3 gap-2">
                {% for state in learningStates %}
                    <button type="submit" name="learning_state" value="{{ state }}" class="btn btn-outline btn-sm w-full">{{ ('exercise_session.learning_state.' ~ state)|trans }}</button>
                {% endfor %}
            </div>
            <label class="mt-4 block">
                <span class="block eyebrow">{{ 'exercise_session.finish.note_label'|trans }}</span>
                {# Prefilled with today's note (there's at most one per
                   exercise per day, see SessionRecorder::finish()) so it
                   stays visible/editable all day instead of starting blank
                   every time and silently overwriting what's already there. #}
                <textarea name="note" rows="2" maxlength="2000" class="textarea textarea-bordered mt-2 w-full" placeholder="{{ 'exercise_session.finish.note_placeholder'|trans }}">{{ todayNote }}</textarea>
            </label>
            <button type="submit" class="btn btn-primary btn-block mt-3">{{ 'exercise_session.finish.submit'|trans }}</button>
        </form>
    </div>

    <form
            id="exercise-session-discard" method="post" action="{{ path('exercise_session_discard', {id: session.id}) }}"
            data-controller="submit-loading" data-action="submit->submit-loading#submit"
    >
        <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">
        {% if returnRouteId %}
            <input type="hidden" name="return_route" value="routine_show">
            <input type="hidden" name="return_route_id" value="{{ returnRouteId }}">
        {% endif %}
    </form>
    <div class="contents" data-controller="confirm-modal">
        <button type="button" class="btn btn-ghost btn-block text-error mt-4" data-action="confirm-modal#open">{{ 'exercise_session.discard.submit'|trans }}</button>
        {{ confirmModal.dialog('exercise-session-discard', 'exercise_session.discard.confirm'|trans, 'exercise_session.discard.submit'|trans) }}
    </div>
{% endblock %}
