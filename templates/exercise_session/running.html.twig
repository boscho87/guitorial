{% extends 'base.html.twig' %}

{% block title %}{{ 'exercise_session.title'|trans }} – Guitorial{% endblock %}

{% block body %}
    <a href="{{ returnRouteId ? path('routine_show', {id: returnRouteId}) : path('diary_index') }}" class="inline-flex items-center gap-1 text-sm text-base-content/70 hover:text-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M19 12H5M11 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {{ 'nav.diary'|trans }}
    </a>

    <h1 class="font-display mt-3 text-2xl font-semibold sm:text-3xl">{{ title ?? 'exercise_session.untitled'|trans }}</h1>

    <div
            class="stat-tile mt-8 flex flex-col items-center gap-2 py-10 text-center"
            data-controller="session-heartbeat"
            data-session-heartbeat-url-value="{{ path('exercise_session_heartbeat', {id: session.id}) }}"
            data-session-heartbeat-token-value="{{ csrf_token(csrfIntention) }}"
    >
        {# Wall-clock elapsed time (from the session's real startedAt, never a JS
           countdown) - stays correct across a closed tab/standby, unlike setInterval counting. #}
        <span
                class="font-mono text-5xl font-semibold text-primary"
                data-controller="timer" data-timer-start-value="{{ startedAtMs }}"
                {% if targetSeconds %}data-timer-target-seconds-value="{{ targetSeconds }}"{% endif %}
        >0:00</span>
        {% if targetSeconds %}
            <p class="text-xs text-base-content/60">{{ 'exercise_session.target'|trans({'%minutes%': (targetSeconds / 60)|round}) }}</p>
        {% endif %}
    </div>

    {% if resource and not resource.isInternalTool %}
        <a href="{{ resource.externalUrl }}" target="_blank" rel="noopener" class="btn btn-outline btn-block mt-6">
            {{ 'exercise_session.reopen_resource'|trans }} ({{ resource.externalProvider ?? resource.externalUrl }})
        </a>
    {% elseif openableResources is not empty %}
        <div class="mt-6 flex flex-col gap-2">
            {% for openableResource in openableResources %}
                <a href="{{ openableResource.externalUrl }}" target="_blank" rel="noopener" class="btn btn-outline btn-block">
                    {{ 'exercise_session.reopen_resource'|trans }} ({{ openableResource.externalProvider ?? openableResource.externalUrl }})
                </a>
            {% endfor %}
        </div>
    {% endif %}

    <div class="mt-8">
        <h2 class="text-xs font-semibold uppercase tracking-wide text-base-content/70">{{ 'exercise_session.finish.title'|trans }}</h2>
        <form method="post" action="{{ path('exercise_session_finish', {id: session.id}) }}" class="mt-3">
            <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">
            {% if returnRouteId %}
                <input type="hidden" name="return_route" value="routine_show">
                <input type="hidden" name="return_route_id" value="{{ returnRouteId }}">
            {% endif %}
            <div class="grid grid-cols-3 gap-2">
                {% for state in learningStates %}
                    <button type="submit" name="learning_state" value="{{ state }}" class="btn btn-outline btn-sm w-full">{{ ('exercise_session.learning_state.' ~ state)|trans }}</button>
                {% endfor %}
            </div>
            <label class="mt-4 block">
                <span class="block text-xs font-semibold uppercase tracking-wide text-base-content/70">{{ 'exercise_session.finish.note_label'|trans }}</span>
                <textarea name="note" rows="2" maxlength="2000" class="textarea textarea-bordered mt-2 w-full" placeholder="{{ 'exercise_session.finish.note_placeholder'|trans }}"></textarea>
            </label>
            <button type="submit" class="btn btn-primary btn-block mt-3">{{ 'exercise_session.finish.submit'|trans }}</button>
        </form>
    </div>

    <form
            method="post" action="{{ path('exercise_session_discard', {id: session.id}) }}" class="mt-4"
            data-controller="confirm-submit" data-confirm-submit-message-value="{{ 'exercise_session.discard.confirm'|trans }}"
            data-action="submit->confirm-submit#submit"
    >
        <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">
        {% if returnRouteId %}
            <input type="hidden" name="return_route" value="routine_show">
            <input type="hidden" name="return_route_id" value="{{ returnRouteId }}">
        {% endif %}
        <button type="submit" class="btn btn-ghost btn-block text-error">{{ 'exercise_session.discard.submit'|trans }}</button>
    </form>
{% endblock %}
