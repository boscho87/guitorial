{% extends 'base.html.twig' %}
{% import '_components/icons.html.twig' as icons %}

{% block title %}{{ 'scale_generator.meta_title'|trans }} – Guitorial{% endblock %}

{% block meta_description %}{{ 'scale_generator.description'|trans }}{% endblock %}

{% block body %}
    <a href="{{ returnRouteId ? path('routine_show', {id: returnRouteId}) : path('training_index') }}" class="inline-flex items-center gap-1 text-sm text-base-content/70 hover:text-primary">
        {{ icons.icon('back') }}
        {{ 'nav.back_home'|trans }}
    </a>

    <h1 class="font-display mt-3 text-2xl font-semibold sm:text-3xl">{{ 'scale_generator.title'|trans }}</h1>
    <p class="mt-2 text-base-content/70">{{ 'scale_generator.settings.intro'|trans }}</p>

    <form
            method="post" action="{{ path('scale_generator_start') }}" class="mt-8 space-y-6"
            data-controller="key-settings submit-loading" data-key-settings-storage-key-value="guitorial:scale-generator:settings"
            data-action="submit->submit-loading#submit"
    >
        <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">
        {% if planExerciseId %}
            <input type="hidden" name="uebung" value="{{ planExerciseId }}">
            <input type="hidden" name="ressource" value="{{ planResourceId }}">
        {% endif %}
        {% if returnRouteId %}
            <input type="hidden" name="return_route" value="routine_show">
            <input type="hidden" name="return_route_id" value="{{ returnRouteId }}">
        {% endif %}

        <div>
            <h2 class="eyebrow">{{ 'scale_generator.settings.tones_label'|trans }}</h2>
            <div class="mt-3 flex flex-wrap gap-2">
                {% for tone in allTones %}
                    <input
                            type="checkbox" class="sr-only" id="sg-tone-{{ loop.index }}" name="tones[]" value="{{ tone }}"
                            {{ tone in activeTones ? 'checked' : '' }}
                            data-key-settings-target="checkbox" data-action="change->key-settings#persist"
                    >
                    <label class="chip-toggle font-mono" for="sg-tone-{{ loop.index }}">{{ tone }}</label>
                {% endfor %}
            </div>
        </div>

        <div class="flex items-center gap-3">
            <label for="auto_advance_seconds" class="text-sm text-base-content/70">{{ 'scale_generator.settings.auto_advance_label'|trans }}</label>
            <input
                    type="number" min="0" max="120" step="5" name="auto_advance_seconds" id="auto_advance_seconds"
                    value="{{ autoAdvanceSeconds }}" class="input input-sm input-bordered w-20 font-mono"
                    data-key-settings-target="questionCount" data-action="input->key-settings#persist"
            >
            <span class="text-xs text-base-content/60">{{ 'scale_generator.settings.auto_advance_hint'|trans }}</span>
        </div>

        <button type="submit" class="btn btn-primary">{{ 'scale_generator.settings.continue'|trans }}</button>
    </form>
{% endblock %}
