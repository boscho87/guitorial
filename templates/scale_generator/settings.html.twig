{% extends 'base.html.twig' %}

{% block title %}{{ 'scale_generator.title'|trans }} – Guitorial{% endblock %}

{% block body %}
    <a href="{{ path('home_index') }}" class="inline-flex items-center gap-1 text-sm text-base-content/70 hover:text-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M19 12H5M11 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {{ 'nav.back_home'|trans }}
    </a>

    <h1 class="font-display mt-3 text-2xl font-semibold sm:text-3xl">{{ 'scale_generator.title'|trans }}</h1>
    <p class="mt-2 text-base-content/70">{{ 'scale_generator.settings.intro'|trans }}</p>

    <form
            method="post" action="{{ path('scale_generator_start') }}" class="mt-8 space-y-6"
            data-controller="key-settings" data-key-settings-storage-key-value="guitorial:scale-generator:settings"
    >
        <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">

        <div>
            <h2 class="text-xs font-semibold uppercase tracking-wide text-base-content/70">{{ 'scale_generator.settings.types_label'|trans }}</h2>
            <div class="mt-3 flex flex-wrap gap-2">
                {% for typeId in typeIds %}
                    <input
                            type="checkbox" class="sr-only" id="sg-type-{{ typeId }}" name="types[]" value="{{ typeId }}"
                            {{ typeId in activeTypes ? 'checked' : '' }}
                            data-key-settings-target="checkbox" data-action="change->key-settings#persist"
                    >
                    <label class="chip-toggle" for="sg-type-{{ typeId }}">{{ ('scale_generator.type.' ~ typeId)|trans }}</label>
                {% endfor %}
            </div>
        </div>

        <button type="submit" class="btn btn-primary">{{ 'scale_generator.settings.continue'|trans }}</button>
    </form>
{% endblock %}
