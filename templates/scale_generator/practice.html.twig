{% extends 'base.html.twig' %}
{% import '_components/icons.html.twig' as icons %}

{% block title %}{{ 'scale_generator.meta_title'|trans }} – Guitorial{% endblock %}

{% block body %}
    <a href="{{ returnRouteId ? path('routine_show', {id: returnRouteId}) : path('training_index') }}" class="inline-flex items-center gap-1 text-sm text-base-content/70 hover:text-primary">
        {{ icons.icon('back') }}
        {{ 'nav.back_home'|trans }}
    </a>

    {# The practice-sync controller must live on an element *inside* the turbo-frame, not on
       the frame itself: Turbo only swaps a frame's content on navigation, never its own
       attributes, so a controller on the <turbo-frame> tag would never reconnect and its
       data-*-value attributes would stay frozen at their first-load values forever. #}
    <turbo-frame id="scale-generator-practice" class="mt-4 block">
    <div
            data-controller="practice-sync" data-practice-sync-tool-value="skalen-generator"
            data-practice-sync-finished-value="{{ finished ? 'true' : 'false' }}"
            data-practice-sync-question-index-value="{{ questionIndex }}"
            data-practice-sync-total-questions-value="{{ totalQuestions }}"
            data-practice-sync-session-id-value="{{ sessionId }}"
    >
        {% if not finished %}
            <div class="stat-tile flex items-center justify-between gap-3 font-mono text-sm text-base-content/70">
                <span>{{ 'scale_generator.practice.progress'|trans({'%current%': questionIndex, '%total%': totalQuestions}) }}</span>
                <span data-controller="timer" data-timer-start-value="{{ startedAtMs }}">0:00</span>
            </div>
        {% endif %}

        {% if finished %}
            <section class="mt-16 text-center sm:mt-24">
                <h2 class="text-xs uppercase tracking-widest text-base-content/70">{{ 'scale_generator.summary.title'|trans }}</h2>
                <p class="mt-4 font-mono text-5xl font-semibold text-primary sm:text-6xl">{{ 'scale_generator.summary.result'|trans({'%total%': totalQuestions}) }}</p>
                <p class="mt-2 font-mono text-sm text-base-content/70">
                    {{ 'scale_generator.summary.time'|trans({'%time%': elapsedLabel}) }}
                </p>
                <div class="mt-10 flex flex-wrap justify-center gap-3">
                    <form method="post" action="{{ path('scale_generator_restart') }}" data-controller="restart-shortcut">
                        <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">
                        <button type="submit" class="btn btn-primary">{{ 'scale_generator.summary.restart'|trans }}</button>
                    </form>
                    <a href="{{ path('scale_generator_settings', returnRouteId ? {return_route: 'routine_show', return_route_id: returnRouteId} : {}) }}" data-turbo-frame="_top" class="btn btn-outline">{{ 'scale_generator.summary.change_settings'|trans }}</a>
                    {% if promotable %}
                        <form method="post" action="{{ path('history_promote_to_exercise', {session: sessionId}) }}" data-turbo-frame="_top">
                            <input type="hidden" name="_token" value="{{ csrf_token('history') }}">
                            <button type="submit" class="btn btn-ghost">{{ 'history.promote.submit'|trans }}</button>
                        </form>
                    {% endif %}
                </div>
            </section>
        {% else %}
            <section class="mt-16 text-center sm:mt-24">
                {% if mode == 'scale' and scaleLabel %}
                    <p class="text-xs uppercase tracking-widest text-base-content/70">{{ scaleLabel }}</p>
                {% else %}
                    <p class="text-xs uppercase tracking-widest text-base-content/70">{{ 'scale_generator.practice.prompt'|trans }}</p>
                {% endif %}
                <p class="font-display mt-4 text-7xl font-semibold text-primary sm:text-8xl">{{ tone }}</p>
                {% if mode == 'scale' and scaleLabel %}
                    <p class="mt-3 text-sm text-base-content/70">{{ 'scale_generator.practice.prompt'|trans }}</p>
                {% endif %}

                <div class="mt-10 flex flex-wrap justify-center gap-3">
                    <form
                            method="post" action="{{ path('scale_generator_next') }}"
                            data-controller="restart-shortcut auto-advance" data-auto-advance-seconds-value="{{ autoAdvanceSeconds }}"
                    >
                        <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">
                        <button type="submit" class="btn btn-primary">{{ 'scale_generator.practice.next'|trans }}</button>
                    </form>
                </div>
                {% if autoAdvanceSeconds > 0 %}
                    <p class="mt-3 text-xs text-base-content/50">{{ 'scale_generator.practice.auto_advance_hint'|trans({'%seconds%': autoAdvanceSeconds}) }}</p>
                {% endif %}
            </section>
        {% endif %}
    </div>
    </turbo-frame>
{% endblock %}
