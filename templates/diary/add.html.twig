{% extends 'base.html.twig' %}

{% block title %}{{ 'diary.add.title'|trans }} – Guitorial{% endblock %}

{% block body %}
    <a href="{{ path('diary_manage') }}" class="inline-flex items-center gap-1 text-sm text-base-content/70 hover:text-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M19 12H5M11 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {{ 'diary.manage.back_to_list'|trans }}
    </a>

    <h1 class="font-display mt-3 text-2xl font-semibold sm:text-3xl">{{ 'diary.add.title'|trans }}</h1>
    <p class="mt-2 text-base-content/70">{{ 'diary.add.intro'|trans }}</p>

    <section class="mt-8">
        <h2 class="text-xs font-semibold uppercase tracking-wide text-base-content/70">{{ 'diary.add.suggestions_label'|trans }}</h2>
        <div class="mt-3 flex flex-wrap gap-2">
            {% for s in suggestions %}
                <form method="post" action="{{ path('diary_add') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">
                    <input type="hidden" name="title" value="{{ s.label|trans }}">
                    {% if s.linkedTool %}
                        <input type="hidden" name="resource_type[]" value="internal_tool">
                        <input type="hidden" name="resource_tool_id[]" value="{{ s.linkedTool }}">
                        <input type="hidden" name="target_minutes" value="{{ s.targetMinutes }}">
                    {% endif %}
                    <button type="submit" class="chip-toggle border border-base-300">{{ s.label|trans }}</button>
                </form>
            {% endfor %}
        </div>
    </section>

    <section class="mt-10">
        <h2 class="text-xs font-semibold uppercase tracking-wide text-base-content/70">{{ 'diary.add.custom_label'|trans }}</h2>
        <form method="post" action="{{ path('diary_add') }}" class="mt-3 flex flex-wrap items-center gap-2" data-controller="submit-loading" data-action="submit->submit-loading#submit">
            <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">
            <input type="text" name="title" maxlength="120" required class="input input-bordered flex-1" placeholder="{{ 'diary.form.title_placeholder'|trans }}">
            <button type="submit" class="btn btn-primary">{{ 'diary.add.submit'|trans }}</button>
        </form>
        <p class="mt-2 text-xs text-base-content/50">{{ 'diary.add.custom_hint'|trans }}</p>
    </section>
{% endblock %}
