{% extends 'base.html.twig' %}

{% block title %}{{ 'diary.title'|trans }} – Guitorial{% endblock %}

{% block body %}
    <a href="{{ path('home_index') }}" class="inline-flex items-center gap-1 text-sm text-base-content/70 hover:text-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M19 12H5M11 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {{ 'nav.back_home'|trans }}
    </a>

    <div class="mt-3 flex flex-wrap items-start justify-between gap-3">
        <div>
            <h1 class="font-display text-2xl font-semibold sm:text-3xl">{{ 'diary.title'|trans }}</h1>
            <p class="mt-2 text-base-content/70">{{ 'diary.intro'|trans }}</p>
        </div>
        <a href="{{ path('diary_manage') }}" class="btn btn-outline btn-sm shrink-0">{{ 'diary.manage_link'|trans }}</a>
    </div>

    <div class="mt-6 flex items-center justify-between gap-3 rounded-box border border-base-300 bg-base-200/40 px-4 py-2">
        <a href="{{ path('diary_index', {datum: previousDate|date('Y-m-d')}) }}" class="btn btn-ghost btn-xs" aria-label="{{ 'diary.pager.previous'|trans }}">&larr;</a>
        <p class="font-mono text-sm font-medium">
            {{ isToday ? 'diary.pager.today'|trans : viewDate|date('d.m.Y') }}
        </p>
        {% if nextDate %}
            <a href="{{ path('diary_index', {datum: nextDate|date('Y-m-d')}) }}" class="btn btn-ghost btn-xs" aria-label="{{ 'diary.pager.next'|trans }}">&rarr;</a>
        {% else %}
            <span class="btn btn-ghost btn-xs invisible" aria-hidden="true">&rarr;</span>
        {% endif %}
    </div>

    {% if dayItems is empty %}
        <p class="mt-8 text-sm text-base-content/60">{{ isToday ? 'diary.empty'|trans : 'diary.empty_past'|trans }}</p>
    {% else %}
        {% for cat in categories %}
            {% set catItems = dayItems|filter(row => row.item.category == cat) %}
            {% if catItems is not empty %}
                <section class="mt-8">
                    <h2 class="text-xs font-semibold uppercase tracking-wide text-base-content/70">{{ ('diary.category.' ~ cat)|trans }}</h2>
                    <ul class="mt-3 space-y-2">
                        {% for row in catItems %}
                            <li class="flex items-start gap-3 rounded-box border border-base-300 p-4">
                                {% if isToday and not row.autoTracked %}
                                    <form method="post" action="{{ path('diary_toggle_check', {id: row.item.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">
                                        <button type="submit" class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full border {{ row.checked ? 'border-primary bg-primary/10 text-primary' : 'border-base-300 text-base-content/40 hover:border-primary' }}" aria-label="{{ 'diary.item.toggle'|trans }}">{% if row.checked %}&check;{% endif %}</button>
                                    </form>
                                {% else %}
                                    <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full border {{ row.checked ? 'border-primary bg-primary/10 text-primary' : 'border-base-300 text-base-content/40' }}">{% if row.checked %}&check;{% endif %}</span>
                                {% endif %}
                                <div>
                                    <p class="text-sm font-medium {{ row.checked ? 'text-base-content/50 line-through' : '' }}">{{ row.item.label }}</p>
                                    {% if row.toolTitle %}
                                        <p class="mt-0.5 text-xs text-base-content/60">
                                            {{ 'diary.item.linked_to'|trans({'%tool%': row.toolTitle|trans}) }}
                                            {% if row.autoTracked %} &middot; {{ 'diary.item.progress'|trans({'%minutes%': row.practicedMinutes, '%target%': row.item.targetMinutes}) }}{% endif %}
                                            {% if isToday %}<a href="{{ path(row.toolRoute) }}" data-turbo-frame="_top" class="ml-1 underline">{{ 'diary.item.practice_now'|trans }}</a>{% endif %}
                                        </p>
                                    {% endif %}
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                </section>
            {% endif %}
        {% endfor %}
    {% endif %}

    <div class="mt-10">
        <h2 class="text-xs font-semibold uppercase tracking-wide text-base-content/70">{{ 'diary.recent.title'|trans }}</h2>
        <div class="mt-3 flex gap-2">
            {% for day in recentRatios %}
                <a href="{{ path('diary_index', {datum: day.date|date('Y-m-d')}) }}" class="stat-tile flex-1 text-center transition-colors hover:border-primary" title="{{ day.date|date('d.m.Y') }}">
                    <p class="text-[10px] uppercase text-base-content/60">{{ day.weekdayLabel }}</p>
                    <p class="mt-1 font-mono text-sm font-semibold {{ day.total > 0 and day.done == day.total ? 'text-primary' : 'text-base-content/70' }}">{{ day.total > 0 ? day.done ~ '/' ~ day.total : '–' }}</p>
                </a>
            {% endfor %}
        </div>
    </div>
{% endblock %}
