{% extends 'base.html.twig' %}

{% block title %}{{ 'diary.title'|trans }} – Guitorial{% endblock %}

{% block meta_description %}{{ 'diary.meta_description'|trans }}{% endblock %}

{% block body %}
    <a href="{{ path('home_index') }}" class="inline-flex items-center gap-1 text-sm text-base-content/70 hover:text-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M19 12H5M11 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {{ 'nav.back_home'|trans }}
    </a>

    <div class="mt-3 flex flex-wrap items-start justify-between gap-3">
        <div>
            <h1 class="font-display text-2xl font-semibold sm:text-3xl">{{ 'diary.title'|trans }}</h1>
            <p class="mt-2 text-base-content/70">{{ 'diary.intro'|trans }}</p>
        </div>
        <a href="{{ path('diary_manage') }}" class="btn btn-outline btn-sm shrink-0">{{ 'diary.manage_link'|trans }}</a>
    </div>

    <div class="mt-6 flex items-center justify-between gap-3 rounded-box border border-base-300 bg-base-200/40 px-4 py-2">
        <a href="{{ path('diary_index', {datum: previousDate|date('Y-m-d')}) }}" class="btn btn-ghost btn-xs" aria-label="{{ 'diary.pager.previous'|trans }}">&larr;</a>
        <p class="font-mono text-sm font-medium">
            {{ isToday ? 'diary.pager.today'|trans : viewDate|date('d.m.Y') }}
        </p>
        {% if nextDate %}
            <a href="{{ path('diary_index', {datum: nextDate|date('Y-m-d')}) }}" class="btn btn-ghost btn-xs" aria-label="{{ 'diary.pager.next'|trans }}">&rarr;</a>
        {% else %}
            <span class="btn btn-ghost btn-xs invisible" aria-hidden="true">&rarr;</span>
        {% endif %}
    </div>

    {% if grouped is empty %}
        <p class="mt-8 text-sm text-base-content/60">{{ isToday ? 'diary.empty'|trans : 'diary.empty_past'|trans }}</p>
    {% else %}
        {% for bucket in grouped %}
            <section class="mt-8">
                <h2 class="text-xs font-semibold uppercase tracking-wide text-base-content/70">{{ bucket.group ? bucket.group.name : 'diary.form.no_group'|trans }}</h2>
                <ul class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2 sm:gap-3">
                    {% for row in bucket.rows %}
                        {% set exercise = row.version.exercise %}
                        {% set resources = resourcesByExerciseId[exercise.id] %}
                        <li class="rounded-box border border-base-300 p-4">
                            <div class="flex items-start gap-3">
                                {% if isToday and not row.checked %}
                                    <form method="post" action="{{ path('diary_mark_done', {id: exercise.id}) }}" class="shrink-0">
                                        <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">
                                        <button
                                                type="submit"
                                                class="mt-0.5 flex h-5 w-5 items-center justify-center rounded-full border border-base-300 text-transparent transition-colors hover:border-primary hover:bg-primary/10 hover:text-primary focus-visible:border-primary focus-visible:text-primary"
                                                title="{{ 'diary.item.mark_done'|trans }}"
                                                aria-label="{{ 'diary.item.mark_done'|trans }}"
                                        >&check;</button>
                                    </form>
                                {% else %}
                                    <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full border {{ row.checked ? 'border-primary bg-primary/10 text-primary' : 'border-base-300 text-base-content/40' }}">{% if row.checked %}&check;{% endif %}</span>
                                {% endif %}
                                <div class="min-w-0 flex-1">
                                    <p class="text-sm font-medium {{ row.checked ? 'text-base-content/50 line-through' : '' }}">{{ row.version.title }}</p>
                                    <div class="mt-1.5 flex flex-wrap items-center gap-1.5">
                                        <span class="badge badge-sm badge-outline">
                                            {{ ('diary.rhythm.' ~ row.version.repeatRhythm)|trans }}
                                            {% if row.weeklyTarget %} {{ row.weeklyDone }}/{{ row.weeklyTarget }}{% endif %}
                                        </span>
                                        {% if bucket.group %}<span class="badge badge-sm badge-ghost">{{ bucket.group.name }}</span>{% endif %}
                                        {% if row.version.targetMinutes %}<span class="text-xs text-base-content/60">{{ 'diary.item.progress'|trans({'%minutes%': row.practicedMinutes, '%target%': row.version.targetMinutes}) }}</span>{% endif %}
                                    </div>
                                    {% if exercise.note %}
                                        <p class="mt-1.5 text-xs text-base-content/50">{{ exercise.note|length > 80 ? exercise.note|slice(0, 80) ~ '…' : exercise.note }}</p>
                                    {% endif %}

                                    {% if isToday %}
                                        <div class="mt-1.5 flex flex-wrap items-center gap-2">
                                            {% if row.runningSessionId %}
                                                {% if row.runningSessionTool %}
                                                    <a href="{{ path(toolPracticeRoutes[row.runningSessionTool]) }}" data-turbo-frame="_top" class="btn btn-primary btn-xs">{{ 'diary.item.resume'|trans }}</a>
                                                {% else %}
                                                    <a href="{{ path('exercise_session_running', {id: row.runningSessionId}) }}" class="btn btn-primary btn-xs">{{ 'diary.item.resume'|trans }}</a>
                                                {% endif %}
                                            {% elseif resources is not empty %}
                                                {% for resource in resources %}
                                                    {% if resource.isInternalTool %}
                                                        <a href="{{ path(toolSettingsRoutes[resource.internalToolId], {uebung: exercise.id, ressource: resource.id}) }}" data-turbo-frame="_top" class="btn btn-outline btn-xs">{{ 'diary.item.start'|trans }}: {{ toolTitles[resource.internalToolId]|trans }}</a>
                                                    {% else %}
                                                        <button
                                                                type="button" class="btn btn-outline btn-xs"
                                                                data-controller="exercise-external-start"
                                                                data-exercise-external-start-url-value="{{ resource.externalUrl }}"
                                                                data-exercise-external-start-start-url-value="{{ path('exercise_start_external', {id: exercise.id, resourceId: resource.id}) }}"
                                                                data-exercise-external-start-token-value="{{ csrf_token(sessionCsrfIntention) }}"
                                                                data-action="click->exercise-external-start#start"
                                                        >{{ 'diary.item.start'|trans }}: {{ resource.externalProvider ?? resource.externalUrl }}</button>
                                                    {% endif %}
                                                {% endfor %}
                                            {% else %}
                                                <form method="post" action="{{ path('exercise_start_manual', {id: exercise.id}) }}">
                                                    <input type="hidden" name="_token" value="{{ csrf_token(sessionCsrfIntention) }}">
                                                    <button type="submit" class="btn btn-outline btn-xs">{{ 'diary.item.start'|trans }}</button>
                                                </form>
                                            {% endif %}
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% endfor %}
    {% endif %}

    <div class="mt-10">
        <h2 class="text-xs font-semibold uppercase tracking-wide text-base-content/70">{{ 'diary.recent.title'|trans }}</h2>
        <div class="mt-3 flex gap-2">
            {% for day in recentRatios %}
                <a href="{{ path('diary_index', {datum: day.date|date('Y-m-d')}) }}" class="stat-tile flex-1 text-center transition-colors hover:border-primary" title="{{ day.date|date('d.m.Y') }}">
                    <p class="text-[10px] uppercase text-base-content/60">{{ day.weekdayLabel }}</p>
                    <p class="mt-1 font-mono text-sm font-semibold {{ day.total > 0 and day.done == day.total ? 'text-primary' : 'text-base-content/70' }}">{{ day.total > 0 ? day.done ~ '/' ~ day.total : '–' }}</p>
                </a>
            {% endfor %}
        </div>
    </div>
{% endblock %}
