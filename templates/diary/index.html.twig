{% extends 'base.html.twig' %}
{% import '_components/icons.html.twig' as icons %}

{% block title %}{{ 'diary.title'|trans }} – Guitorial{% endblock %}

{% block meta_description %}{{ 'diary.meta_description'|trans }}{% endblock %}

{# Whether a card shows "Start" or "Fortsetzen" depends on live server
   state (is anything running right now, how much is already done today) -
   a stale Turbo-cached snapshot from before an exercise was started would
   still show "Start", and clicking it would look like it "restarted"
   (functionally it wouldn't - see ExerciseSessionController - but it's
   confusing either way). Always fetch fresh instead. #}
{% block head_extra %}<meta name="turbo-cache-control" content="no-cache">{% endblock %}

{% block body %}
    <a href="{{ path('training_index') }}" class="inline-flex items-center gap-1 text-sm text-base-content/70 hover:text-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M19 12H5M11 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {{ 'nav.back_home'|trans }}
    </a>

    <div class="mt-3 flex flex-wrap items-start justify-between gap-3">
        <div>
            <h1 class="font-display text-2xl font-semibold sm:text-3xl">{{ 'diary.title'|trans }}</h1>
            <p class="mt-2 text-base-content/70">{{ 'diary.intro'|trans }}</p>
        </div>
        <a href="{{ path('diary_manage') }}" class="btn btn-outline btn-sm shrink-0">{{ 'diary.manage_link'|trans }}</a>
    </div>

    <div class="mt-4 mb-6 flex flex-wrap items-center justify-between gap-3">
        {{ include('diary/_area_nav.html.twig', {active: 'today', bare: true}) }}
        {% if currentStreak > 0 %}
            <a href="{{ path('progress_index') }}" class="badge badge-outline badge-lg gap-1.5 hover:border-primary hover:text-primary">
                🔥 {{ (currentStreak == 1 ? 'history.stats.streak_value_one' : 'history.stats.streak_value_other')|trans({'%days%': currentStreak}) }}
            </a>
        {% endif %}
    </div>

    <div class="flex items-center justify-between gap-3 rounded-box border border-base-300 bg-base-200/40 px-4 py-2">
        <a href="{{ path('diary_index', {datum: previousDate|date('Y-m-d')}) }}" class="btn btn-ghost btn-sm" aria-label="{{ 'diary.pager.previous'|trans }}">&larr;</a>
        {% if isToday %}
            <p class="font-mono text-sm font-medium">{{ 'diary.pager.today'|trans }}</p>
        {% else %}
            <a href="{{ path('diary_index') }}" class="font-mono text-sm font-medium underline decoration-base-content/30 underline-offset-2 hover:text-primary" title="{{ 'diary.pager.today'|trans }}">{{ viewDate|date('d.m.Y') }}</a>
        {% endif %}
        {% if nextDate %}
            <a href="{{ path('diary_index', {datum: nextDate|date('Y-m-d')}) }}" class="btn btn-ghost btn-sm" aria-label="{{ 'diary.pager.next'|trans }}">&rarr;</a>
        {% else %}
            <span class="btn btn-ghost btn-sm invisible" aria-hidden="true">&rarr;</span>
        {% endif %}
    </div>

    {% if isToday %}
        <form method="post" action="{{ path('diary_note_save') }}" class="mt-3">
            <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">
            <label for="day-note" class="text-xs font-semibold uppercase tracking-wide text-base-content/70">{{ 'diary.day_note.label'|trans }}</label>
            <div class="mt-1 flex gap-2">
                <input id="day-note" type="text" name="note" maxlength="{{ dayNoteMaxLength }}" value="{{ dayNote }}" placeholder="{{ 'diary.day_note.placeholder'|trans }}" class="input input-bordered input-sm flex-1">
                <button type="submit" class="btn btn-sm btn-outline">{{ 'diary.day_note.save'|trans }}</button>
            </div>
        </form>
    {% elseif dayNote %}
        <p class="mt-3 text-sm text-base-content/70">
            <span class="text-xs font-semibold uppercase tracking-wide text-base-content/50">{{ 'diary.day_note.label'|trans }}:</span>
            {{ dayNote }}
        </p>
    {% endif %}

    {% if isToday and activeRoutine %}
        <div class="mt-4 flex flex-wrap items-center justify-between gap-2 rounded-box border border-primary/30 bg-primary/5 px-4 py-2.5">
            <p class="text-sm">
                <span class="text-base-content/60">{{ 'diary.active_routine.label'|trans }}</span>
                <span class="font-medium">{{ activeRoutine.name }}</span>
            </p>
            <a href="{{ path('routine_index') }}" class="text-xs font-medium text-primary hover:underline">{{ 'diary.active_routine.change'|trans }}</a>
        </div>
    {% endif %}

    {% if dayRows is not empty %}
        <ul class="mt-6 grid grid-cols-1 gap-2 sm:grid-cols-2 sm:gap-3">
            {% for row in dayRows %}
                {% set exercise = row.version.exercise %}
                {{ include('diary/_exercise_row.html.twig', {
                    exercise: exercise,
                    version: row.version,
                    row: row,
                    resources: resourcesByExerciseId[exercise.id],
                    toolTitles: toolTitles,
                    toolSettingsRoutes: toolSettingsRoutes,
                    toolPracticeRoutes: toolPracticeRoutes,
                    sessionCsrfIntention: sessionCsrfIntention,
                    csrfIntention: csrfIntention,
                    groupName: null,
                    isToday: isToday,
                    returnRouteId: null,
                }) }}
            {% endfor %}
        </ul>
    {% elseif isToday and activeRoutine %}
        <p class="mt-8 text-sm text-base-content/60">{{ 'routine.show.empty'|trans }}</p>
    {% else %}
        <p class="mt-8 text-sm text-base-content/60">{{ isToday ? 'diary.empty'|trans : 'diary.empty_past'|trans }}</p>
    {% endif %}

    <div class="mt-10">
        <h2 class="text-xs font-semibold uppercase tracking-wide text-base-content/70">{{ 'diary.recent.title'|trans }}</h2>
        <div class="mt-3 flex gap-2">
            {% for day in recentRatios %}
                <a href="{{ path('diary_index', {datum: day.date|date('Y-m-d')}) }}" class="stat-tile flex-1 text-center transition-colors hover:border-primary" title="{{ day.date|date('d.m.Y') }}">
                    <p class="text-[10px] uppercase text-base-content/60">{{ day.weekdayLabel }}</p>
                    <p class="mt-1 font-mono text-sm font-semibold {{ day.total > 0 and day.done == day.total ? 'text-primary' : 'text-base-content/70' }}">{{ day.total > 0 ? day.done ~ '/' ~ day.total : '–' }}</p>
                </a>
            {% endfor %}
        </div>
    </div>
{% endblock %}
