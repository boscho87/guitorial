{#
    One exercise row as shown on the "Heute" checklist - extracted so the
    same start/mark-done UI can be reused from a Routine's "starten" view.
    Expects: exercise, version (an active ExerciseVersion), row
    ({checked, practicedMinutes, sessionCount, runningSessionId,
    runningSessionTool, weeklyDone, weeklyTarget}), resources (ExerciseResource[] for this
    exercise), toolTitles, toolSettingsRoutes, toolPracticeRoutes
    (id-keyed maps), sessionCsrfIntention, csrfIntention, groupName
    (optional badge text), isToday (start/mark-done actions only ever make
    sense for today - a past-day view stays read-only), returnRouteId
    (optional - a Routine's own id, so "als erledigt markieren" redirects
    back to that Routine's page instead of Heute; omitted/null on Heute
    itself).
#}
{% import '_components/icons.html.twig' as icons %}
{% import '_components/duration.html.twig' as duration %}
<li class="relative rounded-box border border-base-300 p-4">
    <div class="flex items-start gap-2">
        {% if isToday and row.runningSessionId %}
            {% if row.runningSessionTool %}
                <a href="{{ path(toolPracticeRoutes[row.runningSessionTool], returnRouteId ? {return_route: 'routine_show', return_route_id: returnRouteId} : {}) }}" data-turbo-frame="_top" class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-success text-success transition-colors hover:bg-success/10 cursor-pointer after:absolute after:inset-0 after:content-['']" title="{{ 'diary.item.resume'|trans }}" aria-label="{{ 'diary.item.resume'|trans }}">{{ icons.icon('play') }}</a>
            {% else %}
                <a href="{{ path('exercise_session_running', returnRouteId ? {id: row.runningSessionId, return_route: 'routine_show', return_route_id: returnRouteId} : {id: row.runningSessionId}) }}" class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-success text-success transition-colors hover:bg-success/10 cursor-pointer after:absolute after:inset-0 after:content-['']" title="{{ 'diary.item.resume'|trans }}" aria-label="{{ 'diary.item.resume'|trans }}">{{ icons.icon('play') }}</a>
            {% endif %}
        {% elseif isToday and resources|length == 1 and resources[0].isInternalTool %}
            <a href="{{ path(toolSettingsRoutes[resources[0].internalToolId], returnRouteId ? {uebung: exercise.id, ressource: resources[0].id, return_route: 'routine_show', return_route_id: returnRouteId} : {uebung: exercise.id, ressource: resources[0].id}) }}" data-turbo-frame="_top" class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-success text-success transition-colors hover:bg-success/10 cursor-pointer after:absolute after:inset-0 after:content-['']" title="{{ 'diary.item.start'|trans }}: {{ toolTitles[resources[0].internalToolId]|trans }}" aria-label="{{ 'diary.item.start'|trans }}: {{ toolTitles[resources[0].internalToolId]|trans }}">{{ icons.icon('play') }}</a>
        {% elseif isToday and resources|length == 1 %}
            <form method="post" action="{{ path('exercise_start_external', {id: exercise.id, resourceId: resources[0].id}) }}" class="shrink-0">
                <input type="hidden" name="_token" value="{{ csrf_token(sessionCsrfIntention) }}">
                {% if returnRouteId %}
                    <input type="hidden" name="return_route" value="routine_show">
                    <input type="hidden" name="return_route_id" value="{{ returnRouteId }}">
                {% endif %}
                <button type="submit" class="flex h-5 w-5 items-center justify-center rounded-full border border-success text-success transition-colors hover:bg-success/10 cursor-pointer after:absolute after:inset-0 after:content-['']" title="{{ 'diary.item.start'|trans }}: {{ resources[0].externalProvider ?? resources[0].externalUrl }}" aria-label="{{ 'diary.item.start'|trans }}: {{ resources[0].externalProvider ?? resources[0].externalUrl }}">{{ icons.icon('play') }}</button>
            </form>
        {% elseif isToday %}
            {# 0 resources, or 2+ (mixed) resources - either way there's
               nothing unambiguous to pre-select here. Start plainly; which
               resource to open, if more than one, is chosen on the running
               page instead of as a list of raw-URL buttons on this card. #}
            <form method="post" action="{{ path('exercise_start_manual', {id: exercise.id}) }}" class="shrink-0">
                <input type="hidden" name="_token" value="{{ csrf_token(sessionCsrfIntention) }}">
                {% if returnRouteId %}
                    <input type="hidden" name="return_route" value="routine_show">
                    <input type="hidden" name="return_route_id" value="{{ returnRouteId }}">
                {% endif %}
                <button type="submit" class="flex h-5 w-5 items-center justify-center rounded-full border border-success text-success transition-colors hover:bg-success/10 cursor-pointer after:absolute after:inset-0 after:content-['']" title="{{ 'diary.item.start'|trans }}" aria-label="{{ 'diary.item.start'|trans }}">{{ icons.icon('play') }}</button>
            </form>
        {% endif %}
        <p class="min-w-0 flex-1 text-sm font-medium {{ row.checked ? 'text-base-content/50 line-through' : '' }}">{{ version.title }}</p>
        {% if isToday and not row.checked %}
            <form id="mark-done-{{ exercise.id }}" method="post" action="{{ path('diary_mark_done', {id: exercise.id}) }}" class="relative z-10 shrink-0">
                <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">
                {% if returnRouteId %}
                    <input type="hidden" name="return_route" value="routine_show">
                    <input type="hidden" name="return_route_id" value="{{ returnRouteId }}">
                {% endif %}
                <button
                        type="submit"
                        class="flex h-5 w-5 items-center justify-center rounded-full border border-base-300 text-transparent transition-colors hover:border-primary hover:bg-primary/10 hover:text-primary focus-visible:border-primary focus-visible:text-primary"
                        title="{{ 'diary.item.mark_done'|trans }}"
                        aria-label="{{ 'diary.item.mark_done'|trans }}"
                >&check;</button>
            </form>
        {% else %}
            <span class="relative z-10 flex h-5 w-5 shrink-0 items-center justify-center rounded-full border {{ row.checked ? 'border-primary bg-primary/10 text-primary' : 'border-base-300 text-base-content/40' }}">{% if row.checked %}&check;{% endif %}</span>
        {% endif %}
    </div>
    <div class="mt-3 flex flex-wrap items-center justify-between gap-1.5">
        <div class="flex flex-wrap items-center gap-1.5">
            <span class="badge badge-sm badge-outline">
                {{ ('diary.rhythm.' ~ version.repeatRhythm)|trans }}
                {% if row.weeklyTarget %} {{ row.weeklyDone }}/{{ row.weeklyTarget }}{% endif %}
            </span>
            {% if groupName %}<span class="badge badge-sm badge-ghost">{{ groupName }}</span>{% endif %}
        </div>
        <div class="relative z-10 flex shrink-0 gap-0.5">
            <a href="{{ path('history_exercise_detail', {id: exercise.id}) }}" class="btn btn-ghost btn-xs btn-square text-base-content/60" title="{{ 'diary.item.history'|trans }}" aria-label="{{ 'diary.item.history'|trans }}: {{ version.title }}">
                {{ icons.icon('history') }}
            </a>
            {% if isToday %}
                <a href="{{ path('diary_setup', returnRouteId ? {id: exercise.id, return_route: 'routine_show', return_route_id: returnRouteId} : {id: exercise.id}) }}" class="btn btn-ghost btn-xs btn-square text-base-content/60" title="{{ 'diary.item.edit'|trans }}" aria-label="{{ 'diary.item.edit'|trans }}: {{ version.title }}">
                    {{ icons.icon('edit') }}
                </a>
            {% endif %}
        </div>
    </div>
    {% if row.sessionCount > 1 %}
        <p class="mt-1.5 text-xs text-base-content/50">{{ 'diary.item.session_count'|trans({'%count%': row.sessionCount}) }}</p>
    {% endif %}
    {% if version.targetMinutes and row.sessionCount > 0 %}
        <div class="mt-1.5">
            {% if isToday %}
                {# Warm-to-cool progress: still-orange reads as "keep going",
                   settling into green as the target is reached - a smooth
                   hue sweep rather than a hard color swap at some threshold. #}
                {% set percent = min(100, (row.practicedMinutes / version.targetMinutes * 100)|round) %}
                {% set hue = (30 + (148 - 30) * percent / 100)|round %}
                <div class="h-1.5 w-full overflow-hidden rounded-full bg-base-300">
                    <div class="h-full rounded-full transition-[width,background-color] duration-700 ease-out" style="width: {{ percent }}%; background-color: hsl({{ hue }} 75% 48%);"></div>
                </div>
            {% else %}
                <progress class="progress progress-primary h-1 w-full" value="{{ row.practicedMinutes }}" max="{{ version.targetMinutes }}"></progress>
            {% endif %}
            <span class="text-xs text-base-content/60">{{ duration.minutes(row.practicedMinutes) }} {{ 'diary.item.of_target'|trans({'%target%': version.targetMinutes}) }}</span>
        </div>
    {% endif %}
    {% if isToday and exercise.note %}
        <p class="mt-1.5 text-xs text-base-content/50">{{ exercise.note|length > 80 ? exercise.note|slice(0, 80) ~ '…' : exercise.note }}</p>
    {% endif %}
</li>
