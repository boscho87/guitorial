{% extends 'base.html.twig' %}

{% block title %}{{ 'diary.manage.title'|trans }} – Guitorial{% endblock %}

{% block body %}
    <a href="{{ path('diary_index') }}" class="inline-flex items-center gap-1 text-sm text-base-content/70 hover:text-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M19 12H5M11 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {{ 'diary.manage.back_to_diary'|trans }}
    </a>

    <div class="mt-3 flex flex-wrap items-start justify-between gap-3">
        <div>
            <h1 class="font-display text-2xl font-semibold sm:text-3xl">{{ 'diary.manage.title'|trans }}</h1>
            <p class="mt-2 text-base-content/70">{{ 'diary.manage.intro'|trans }}</p>
        </div>
        <a href="{{ path('diary_groups') }}" class="btn btn-outline btn-sm shrink-0">{{ 'diary.groups.title'|trans }}</a>
    </div>

    <section class="mt-10">
        <div class="flex items-center justify-between gap-3">
            <h2 class="text-xs font-semibold uppercase tracking-wide text-base-content/70">{{ 'diary.manage.active_heading'|trans }}</h2>
            <a href="{{ path('diary_add_form') }}" class="btn btn-primary btn-sm">{{ 'diary.add.new_button'|trans }}</a>
        </div>

        {% if activeExercises is empty %}
            <p class="mt-4 text-sm text-base-content/60">{{ 'diary.empty'|trans }}</p>
        {% else %}
            <ul class="mt-4 space-y-2">
                {% for entry in activeExercises %}
                    <li class="rounded-box border border-base-300 p-4">
                        <div class="flex items-start justify-between gap-3">
                            <div>
                                <p class="text-sm font-medium">{{ entry.version.title }}</p>
                                <p class="mt-0.5 text-xs text-base-content/60">
                                    {{ entry.version.group ? entry.version.group.name : 'diary.form.no_group'|trans }}
                                    &middot; {{ ('diary.rhythm.' ~ entry.version.repeatRhythm)|trans }}
                                    {% if entry.version.repeatRhythm == 'pro_woche' %}({{ entry.version.repeatCount }}x){% endif %}
                                    {% if entry.version.targetMinutes %} &middot; {{ entry.version.targetMinutes }} Min.{% endif %}
                                </p>
                                {% if entry.exercise.note %}<p class="mt-1 text-xs text-base-content/50">{{ entry.exercise.note }}</p>{% endif %}
                            </div>
                            <div class="flex shrink-0 gap-1">
                                <a href="{{ path('history_exercise_detail', {id: entry.exercise.id}) }}" class="btn btn-ghost btn-xs">{{ 'history.title'|trans }}</a>
                                <a href="{{ path('diary_setup', {id: entry.exercise.id}) }}" class="btn btn-ghost btn-xs">{{ 'diary.item.edit'|trans }}</a>
                                <form method="post" action="{{ path('diary_archive', {id: entry.exercise.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">
                                    <button type="submit" class="btn btn-ghost btn-xs">{{ 'diary.item.archive'|trans }}</button>
                                </form>
                                <form
                                        method="post" action="{{ path('diary_delete', {id: entry.exercise.id}) }}"
                                        data-controller="confirm-submit" data-confirm-submit-message-value="{{ 'diary.item.delete_confirm'|trans }}"
                                        data-action="submit->confirm-submit#submit"
                                >
                                    <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">
                                    <button type="submit" class="btn btn-ghost btn-xs text-error">{{ 'diary.item.delete'|trans }}</button>
                                </form>
                            </div>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>

    {% if archivedExercises is not empty %}
        <section class="mt-10">
            <h2 class="text-xs font-semibold uppercase tracking-wide text-base-content/70">{{ 'diary.archive.title'|trans }}</h2>
            <ul class="mt-4 space-y-2">
                {% for entry in archivedExercises %}
                    <li class="flex items-center justify-between gap-3 rounded-box border border-base-300 p-4 opacity-70">
                        <p class="text-sm font-medium">{{ entry.version.title }}</p>
                        <div class="flex shrink-0 gap-1">
                            <form method="post" action="{{ path('diary_reactivate', {id: entry.exercise.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">
                                <button type="submit" class="btn btn-ghost btn-xs">{{ 'diary.archive.reactivate'|trans }}</button>
                            </form>
                            <form
                                    method="post" action="{{ path('diary_delete', {id: entry.exercise.id}) }}"
                                    data-controller="confirm-submit" data-confirm-submit-message-value="{{ 'diary.item.delete_confirm'|trans }}"
                                    data-action="submit->confirm-submit#submit"
                            >
                                <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">
                                <button type="submit" class="btn btn-ghost btn-xs text-error">{{ 'diary.item.delete'|trans }}</button>
                            </form>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}
{% endblock %}
