{% extends 'base.html.twig' %}
{% import '_components/icons.html.twig' as icons %}
{% import '_components/confirm_modal.html.twig' as confirmModal %}

{% block title %}{{ 'diary.manage.title'|trans }} – Guitorial{% endblock %}

{% block body %}
    <a href="{{ path('diary_index') }}" class="inline-flex items-center gap-1 text-sm text-base-content/70 hover:text-primary">
        {{ icons.icon('back') }}
        {{ 'diary.manage.back_to_diary'|trans }}
    </a>

    <div class="mt-3 flex flex-wrap items-start justify-between gap-3">
        <div>
            <h1 class="font-display text-2xl font-semibold sm:text-3xl">{{ 'diary.manage.title'|trans }}</h1>
            <p class="mt-2 text-base-content/70">{{ 'diary.manage.intro'|trans }}</p>
        </div>
        <a href="{{ path('diary_groups') }}" class="btn btn-outline btn-sm shrink-0">{{ 'diary.groups.title'|trans }}</a>
    </div>

    {# One frame spans all three tabs - archiving/deactivating/reactivating
       moves an item between them, so a delete/archive/reactivate response
       needs to be able to update any of the three lists, not just the one
       the action started in. #}
    <turbo-frame id="diary-manage-list" class="block">
    {{ include('_components/_frame_toast.html.twig') }}

    <div class="mt-10" data-controller="manage-tabs">
        <div class="flex flex-wrap items-center justify-between gap-3">
            <div class="flex flex-wrap gap-1" role="tablist">
                <input type="radio" name="manage-tab" id="manage-tab-active" value="active" class="sr-only" checked data-action="change->manage-tabs#switch">
                <label for="manage-tab-active" class="chip-toggle">{{ 'diary.manage.active_heading'|trans }} ({{ activeExercises|length }})</label>
                <input type="radio" name="manage-tab" id="manage-tab-deactivated" value="deactivated" class="sr-only" data-action="change->manage-tabs#switch">
                <label for="manage-tab-deactivated" class="chip-toggle">{{ 'diary.deactivate.title'|trans }} ({{ deactivatedExercises|length }})</label>
                <input type="radio" name="manage-tab" id="manage-tab-archived" value="archived" class="sr-only" data-action="change->manage-tabs#switch">
                <label for="manage-tab-archived" class="chip-toggle">{{ 'diary.archive.title'|trans }} ({{ archivedExercises|length }})</label>
            </div>
            <div class="flex items-center gap-2">
                <form method="post" action="{{ path('diary_add') }}" class="flex items-center gap-1">
                    <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">
                    <input type="hidden" name="return_to" value="diary_manage">
                    <input type="text" name="title" maxlength="120" required placeholder="{{ 'diary.manage.quick_add_placeholder'|trans }}" class="input input-sm input-bordered w-40 sm:w-56">
                    <button type="submit" class="btn btn-primary btn-sm btn-square" title="{{ 'diary.add.new_button'|trans }}" aria-label="{{ 'diary.add.new_button'|trans }}">+</button>
                </form>
                <a href="{{ path('diary_add_form') }}" data-turbo-frame="_top" class="btn btn-outline btn-sm" data-hint-id="manage.add" data-hint="{{ 'hints.manage.add'|trans }}">{{ 'diary.add.new_button'|trans }}</a>
            </div>
        </div>

    <section class="mt-4" data-manage-tabs-target="panel" data-tab="active">
        {% if activeExercises is empty %}
            <p class="mt-4 text-sm text-base-content/60">{{ 'diary.empty'|trans }}</p>
        {% else %}
            <ul class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2" data-hint-id="manage.list" data-hint="{{ 'hints.manage.list'|trans }}">
                {% for entry in activeExercises %}
                    <li class="card-tile">
                        <div class="flex items-start justify-between gap-2">
                            <p class="min-w-0 flex-1 text-sm font-medium sm:text-base">{{ entry.version.title }}</p>
                            <div class="flex shrink-0 gap-0.5">
                                <a href="{{ path('history_exercise_detail', {id: entry.exercise.id}) }}" data-turbo-frame="_top" class="btn btn-ghost btn-xs btn-square text-base-content/60" title="{{ 'history.title'|trans }}" aria-label="{{ 'history.title'|trans }}">
                                    {{ icons.icon('history') }}
                                </a>
                                <a href="{{ path('diary_setup', {id: entry.exercise.id}) }}" data-turbo-frame="_top" class="btn btn-ghost btn-xs btn-square text-base-content/60" title="{{ 'diary.item.edit'|trans }}" aria-label="{{ 'diary.item.edit'|trans }}">
                                    {{ icons.icon('edit') }}
                                </a>
                                <form method="post" action="{{ path('diary_archive', {id: entry.exercise.id}) }}" data-controller="submit-loading" data-submit-loading-spinner-value="false" data-action="submit->submit-loading#submit">
                                    <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">
                                    <button type="submit" class="btn btn-ghost btn-xs btn-square" title="{{ 'diary.item.archive'|trans }}" aria-label="{{ 'diary.item.archive'|trans }}">
                                        {{ icons.icon('archive') }}
                                    </button>
                                </form>
                                <form id="exercise-delete-{{ entry.exercise.id }}" method="post" action="{{ path('diary_delete', {id: entry.exercise.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">
                                </form>
                                <div class="contents" data-controller="confirm-modal">
                                    <button type="button" class="btn btn-ghost btn-xs btn-square text-error" data-action="confirm-modal#open" title="{{ 'diary.item.delete'|trans }}" aria-label="{{ 'diary.item.delete'|trans }}">
                                        {{ icons.icon('trash') }}
                                    </button>
                                    {{ confirmModal.dialog('exercise-delete-' ~ entry.exercise.id, 'diary.item.delete_confirm'|trans, 'diary.item.delete'|trans) }}
                                </div>
                            </div>
                        </div>

                        <form
                                method="post" action="{{ path('diary_quick_edit', {id: entry.exercise.id}) }}"
                                data-controller="auto-submit" class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1"
                        >
                            <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">
                            <select name="group_id" class="select select-xs select-bordered" data-action="change->auto-submit#submit">
                                {% for group in groups %}
                                    <option value="{{ group.id }}" {{ entry.version.group and entry.version.group.id == group.id ? 'selected' : '' }}>{{ group.name }}</option>
                                {% endfor %}
                            </select>
                            <select name="rhythm" class="select select-xs select-bordered" data-action="change->auto-submit#submit">
                                {% for r in rhythms %}
                                    <option value="{{ r }}" {{ entry.version.repeatRhythm == r ? 'selected' : '' }}>{{ ('diary.rhythm.' ~ r)|trans }}</option>
                                {% endfor %}
                            </select>
                            {% if entry.version.repeatRhythm == 'pro_woche' %}
                                <span class="text-xs text-base-content/60">({{ entry.version.repeatCount }}x)</span>
                            {% endif %}
                            {% if entry.version.targetMinutes %}
                                <span class="text-xs text-base-content/60">&middot; {{ entry.version.targetMinutes }} Min.</span>
                            {% endif %}
                        </form>
                        {% if entry.exercise.note %}<p class="mt-2 line-clamp-2 text-xs text-base-content/50">{{ entry.exercise.note }}</p>{% endif %}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>

    <section class="mt-4 hidden" data-manage-tabs-target="panel" data-tab="deactivated">
        {% if deactivatedExercises is empty %}
            <p class="mt-4 text-sm text-base-content/60">{{ 'diary.deactivate.empty'|trans }}</p>
        {% else %}
            <ul class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
                {% for entry in deactivatedExercises %}
                    <li class="card-tile flex items-center justify-between gap-2 opacity-70">
                        <div class="min-w-0 flex-1">
                            <p class="text-sm font-medium sm:text-base">{{ entry.version.title }}</p>
                            <p class="mt-1 text-xs text-base-content/50">{{ 'diary.deactivate.hint'|trans }}</p>
                        </div>
                        <div class="flex shrink-0 gap-0.5">
                            <form method="post" action="{{ path('diary_reactivate_from_deactivation', {id: entry.exercise.id}) }}" data-controller="submit-loading" data-submit-loading-spinner-value="false" data-action="submit->submit-loading#submit">
                                <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">
                                <button type="submit" class="btn btn-ghost btn-xs btn-square" title="{{ 'diary.archive.reactivate'|trans }}" aria-label="{{ 'diary.archive.reactivate'|trans }}">
                                    {{ icons.icon('reactivate') }}
                                </button>
                            </form>
                            <form id="exercise-delete-{{ entry.exercise.id }}" method="post" action="{{ path('diary_delete', {id: entry.exercise.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">
                            </form>
                            <div class="contents" data-controller="confirm-modal">
                                <button type="button" class="btn btn-ghost btn-xs btn-square text-error" data-action="confirm-modal#open" title="{{ 'diary.item.delete'|trans }}" aria-label="{{ 'diary.item.delete'|trans }}">
                                    {{ icons.icon('trash') }}
                                </button>
                                {{ confirmModal.dialog('exercise-delete-' ~ entry.exercise.id, 'diary.item.delete_confirm'|trans, 'diary.item.delete'|trans) }}
                            </div>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>

    <section class="mt-4 hidden" data-manage-tabs-target="panel" data-tab="archived">
        {% if archivedExercises is empty %}
            <p class="mt-4 text-sm text-base-content/60">{{ 'diary.archive.empty'|trans }}</p>
        {% else %}
            <ul class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
                {% for entry in archivedExercises %}
                    <li class="card-tile flex items-center justify-between gap-2 opacity-70">
                        <p class="min-w-0 flex-1 text-sm font-medium sm:text-base">{{ entry.version.title }}</p>
                        <div class="flex shrink-0 gap-0.5">
                            <form method="post" action="{{ path('diary_reactivate', {id: entry.exercise.id}) }}" data-controller="submit-loading" data-submit-loading-spinner-value="false" data-action="submit->submit-loading#submit">
                                <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">
                                <button type="submit" class="btn btn-ghost btn-xs btn-square" title="{{ 'diary.archive.reactivate'|trans }}" aria-label="{{ 'diary.archive.reactivate'|trans }}">
                                    {{ icons.icon('reactivate') }}
                                </button>
                            </form>
                            <form id="exercise-delete-{{ entry.exercise.id }}" method="post" action="{{ path('diary_delete', {id: entry.exercise.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">
                            </form>
                            <div class="contents" data-controller="confirm-modal">
                                <button type="button" class="btn btn-ghost btn-xs btn-square text-error" data-action="confirm-modal#open" title="{{ 'diary.item.delete'|trans }}" aria-label="{{ 'diary.item.delete'|trans }}">
                                    {{ icons.icon('trash') }}
                                </button>
                                {{ confirmModal.dialog('exercise-delete-' ~ entry.exercise.id, 'diary.item.delete_confirm'|trans, 'diary.item.delete'|trans) }}
                            </div>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>
    </div>
    </turbo-frame>
{% endblock %}
