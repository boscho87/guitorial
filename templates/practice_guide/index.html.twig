{% extends 'base.html.twig' %}

{% block title %}{{ 'practice_guide.title'|trans }} – Guitorial{% endblock %}

{% block body %}
    <a href="{{ path('home_index') }}" class="inline-flex items-center gap-1 text-sm text-base-content/70 hover:text-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M19 12H5M11 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {{ 'nav.back_home'|trans }}
    </a>

    <h1 class="font-display mt-3 text-2xl font-semibold sm:text-3xl">{{ 'practice_guide.title'|trans }}</h1>

    <section class="mt-8">
        <h2 class="font-display text-lg font-semibold">{{ 'practice_guide.structure.title'|trans }}</h2>
        <p class="mt-2 text-base-content/70">{{ 'practice_guide.structure.body'|trans }}</p>
    </section>

    <section class="mt-8">
        <h2 class="font-display text-lg font-semibold">{{ 'practice_guide.balance.title'|trans }}</h2>
        <p class="mt-2 text-base-content/70">{{ 'practice_guide.balance.body'|trans }}</p>
    </section>

    <section class="mt-8">
        <h2 class="font-display text-lg font-semibold">{{ 'practice_guide.consistency.title'|trans }}</h2>
        <p class="mt-2 text-base-content/70">{{ 'practice_guide.consistency.body'|trans }}</p>
    </section>

    <section class="mt-10">
        <h2 class="font-display text-lg font-semibold">{{ 'practice_guide.cta.title'|trans }}</h2>
        <div class="mt-4 flex flex-wrap gap-3">
            <a href="{{ path('diary_index') }}" class="btn btn-primary">{{ 'practice_guide.cta.diary'|trans }}</a>
            <a href="{{ path('home_index') }}" class="btn btn-outline">{{ 'practice_guide.cta.tools'|trans }}</a>
        </div>
    </section>
{% endblock %}
