{% extends 'base.html.twig' %}

{% block title %}{{ 'capo_trainer.meta_title'|trans }} – Guitorial{% endblock %}

{% block meta_description %}{{ 'capo_trainer.description'|trans }}{% endblock %}

{% block body %}
    <a href="{{ path('training_index') }}" class="inline-flex items-center gap-1 text-sm text-base-content/70 hover:text-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M19 12H5M11 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {{ 'nav.back_home'|trans }}
    </a>

    <h1 class="font-display mt-3 text-2xl font-semibold sm:text-3xl">{{ 'capo_trainer.title'|trans }}</h1>
    <p class="mt-2 text-base-content/70">{{ 'capo_trainer.settings.intro'|trans }}</p>

    <form
            method="post" action="{{ path('capo_trainer_start') }}" class="mt-8 space-y-6"
            data-controller="key-settings" data-key-settings-storage-key-value="guitorial:capo-trainer:settings"
    >
        <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">
        {% if planExerciseId %}
            <input type="hidden" name="uebung" value="{{ planExerciseId }}">
            <input type="hidden" name="ressource" value="{{ planResourceId }}">
        {% endif %}

        <div>
            <h2 class="text-xs font-semibold uppercase tracking-wide text-base-content/70">{{ 'capo_trainer.settings.shapes_label'|trans }}</h2>
            <div class="mt-3 flex flex-wrap gap-2">
                {% for id, shape in allShapes %}
                    <input
                            type="checkbox" class="sr-only" id="ct-shape-{{ id }}" name="shapes[]" value="{{ id }}"
                            {{ id in activeShapes ? 'checked' : '' }}
                            data-key-settings-target="checkbox" data-action="change->key-settings#persist"
                    >
                    <label class="chip-toggle {{ shape.isMinor ? 'chip-toggle-minor' : '' }}" for="ct-shape-{{ id }}">{{ id }}</label>
                {% endfor %}
            </div>
        </div>

        <div>
            <h2 class="text-xs font-semibold uppercase tracking-wide text-base-content/70">{{ 'capo_trainer.settings.mode_label'|trans }}</h2>
            <p class="mt-1 text-xs text-base-content/70">{{ 'capo_trainer.settings.mode_hint'|trans }}</p>
            <div class="mt-3 flex flex-wrap gap-2">
                <input
                        type="checkbox" class="sr-only" name="modes[]" id="ct-mode-1" value="1" {{ '1' in activeModes ? 'checked' : '' }}
                        data-key-settings-target="checkbox" data-action="change->key-settings#persist"
                >
                <label class="chip-toggle" for="ct-mode-1">{{ 'capo_trainer.settings.mode_1'|trans }}</label>

                <input
                        type="checkbox" class="sr-only" name="modes[]" id="ct-mode-2" value="2" {{ '2' in activeModes ? 'checked' : '' }}
                        data-key-settings-target="checkbox" data-action="change->key-settings#persist"
                >
                <label class="chip-toggle" for="ct-mode-2">{{ 'capo_trainer.settings.mode_2'|trans }}</label>

                <input
                        type="checkbox" class="sr-only" name="modes[]" id="ct-mode-3" value="3" {{ '3' in activeModes ? 'checked' : '' }}
                        data-key-settings-target="checkbox" data-action="change->key-settings#persist"
                >
                <label class="chip-toggle" for="ct-mode-3">{{ 'capo_trainer.settings.mode_3'|trans }}</label>
            </div>
        </div>

        <div class="flex flex-wrap items-center gap-6">
            <div class="flex items-center gap-3">
                <label for="max_fret" class="text-sm text-base-content/70">{{ 'capo_trainer.settings.max_fret_label'|trans }}</label>
                <input type="number" min="1" max="11" name="max_fret" id="max_fret" value="{{ maxFret }}" class="input input-sm input-bordered w-20 font-mono">
            </div>
            <div class="flex items-center gap-3">
                <label for="question_count" class="text-sm text-base-content/70">{{ 'capo_trainer.settings.question_count_label'|trans }}</label>
                <input
                        type="number" min="3" max="30" name="question_count" id="question_count"
                        value="{{ questionCount }}" class="input input-sm input-bordered w-20 font-mono"
                        data-key-settings-target="questionCount" data-action="input->key-settings#persist"
                >
            </div>
        </div>

        <button type="submit" class="btn btn-primary">{{ 'capo_trainer.settings.continue'|trans }}</button>
    </form>
{% endblock %}
