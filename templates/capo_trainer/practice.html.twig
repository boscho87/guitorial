{% extends 'base.html.twig' %}

{% block title %}{{ 'capo_trainer.title'|trans }} – Guitorial{% endblock %}

{% block body %}
    <a href="{{ path('home_index') }}" class="inline-flex items-center gap-1 text-sm text-base-content/70 hover:text-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M19 12H5M11 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {{ 'nav.back_home'|trans }}
    </a>

    <turbo-frame
            id="capo-trainer-practice" class="mt-4 block"
            data-controller="practice-sync" data-practice-sync-tool-value="kapo-trainer"
            data-practice-sync-finished-value="{{ finished ? 'true' : 'false' }}"
            data-practice-sync-question-index-value="{{ questionIndex }}"
            data-practice-sync-total-questions-value="{{ totalQuestions }}"
            data-practice-sync-correct-count-value="{{ correctCount }}"
    >
        {% if not finished %}
            <div class="flex items-center justify-end gap-3 font-mono text-sm text-base-content/70">
                <span data-controller="timer" data-timer-start-value="{{ startedAtMs }}">0:00</span>
                <span>{{ 'capo_trainer.practice.question_progress'|trans({'%current%': questionIndex, '%total%': totalQuestions}) }}</span>
            </div>
        {% endif %}

        {% if toast %}
            <div
                    class="toast toast-top toast-center z-50 pointer-events-none transition-opacity duration-300"
                    data-controller="toast"
            >
                <div class="alert {{ toast.correct ? 'alert-success' : 'alert-error' }} shadow-lg">
                    <span>
                        {% if toast.correct %}
                            {{ 'capo_trainer.practice.correct'|trans }}
                        {% else %}
                            {{ 'capo_trainer.practice.incorrect'|trans }}
                            {{ 'capo_trainer.practice.your_guess'|trans({'%guess%': toast.guess}) }}
                        {% endif %}
                        {{ 'capo_trainer.practice.correct_is'|trans({'%shape%': toast.shapeId, '%fret%': toast.fret, '%sounding%': toast.sounding}) }}
                    </span>
                </div>
            </div>
        {% endif %}

        {% if finished %}
            <section class="mt-16 text-center sm:mt-24">
                <h2 class="text-xs uppercase tracking-widest text-base-content/70">{{ 'capo_trainer.summary.title'|trans }}</h2>
                <p class="mt-4 font-mono text-5xl font-semibold text-primary sm:text-6xl">
                    {{ 'capo_trainer.summary.result'|trans({'%correct%': correctCount, '%total%': totalQuestions}) }}
                </p>
                <p class="mt-2 font-mono text-sm text-base-content/70">
                    {{ 'capo_trainer.summary.time'|trans({'%time%': elapsedLabel}) }}
                </p>
                <div class="mt-10 flex flex-wrap justify-center gap-3">
                    <form method="post" action="{{ path('capo_trainer_restart') }}" data-controller="restart-shortcut">
                        <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">
                        <button type="submit" class="btn btn-primary">{{ 'capo_trainer.summary.restart'|trans }}</button>
                    </form>
                    <a href="{{ path('capo_trainer_settings') }}" data-turbo-frame="_top" class="btn btn-outline">{{ 'capo_trainer.summary.change_settings'|trans }}</a>
                </div>
            </section>
        {% else %}
            <section class="mt-16 text-center sm:mt-24">
                {% if mode == '1' %}
                    <p class="text-xs uppercase tracking-widest text-base-content/70">{{ 'capo_trainer.practice.mode_1_hint'|trans({'%fret%': fret, '%shape%': shapeId}) }}</p>
                    <p class="mt-3 text-sm text-base-content/70">{{ 'capo_trainer.practice.mode_1_prompt'|trans }}</p>
                {% elseif mode == '2' %}
                    <p class="text-xs uppercase tracking-widest text-base-content/70">{{ 'capo_trainer.practice.mode_2_hint'|trans({'%fret%': fret, '%sounding%': sounding}) }}</p>
                    <p class="mt-3 text-sm text-base-content/70">{{ 'capo_trainer.practice.mode_2_prompt'|trans }}</p>
                {% else %}
                    <p class="text-xs uppercase tracking-widest text-base-content/70">{{ 'capo_trainer.practice.mode_3_hint'|trans({'%shape%': shapeId, '%sounding%': sounding}) }}</p>
                    <p class="mt-3 text-sm text-base-content/70">{{ 'capo_trainer.practice.mode_3_prompt'|trans }}</p>
                {% endif %}

                <form method="post" action="{{ path('capo_trainer_answer') }}" class="mt-10">
                    <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">
                    <div class="flex flex-wrap justify-center gap-1 sm:gap-2" data-controller="quiz">
                        {% for option in answerOptions %}
                            <button
                                    type="submit" name="guess" value="{{ option }}"
                                    class="answer-btn" data-quiz-target="answer" data-action="quiz#choose"
                            >{% if loop.index <= 10 %}<span class="keycap">{{ loop.index == 10 ? 0 : loop.index }}</span>{% endif %}{{ option }}</button>
                        {% endfor %}
                    </div>
                </form>
            </section>
        {% endif %}
    </turbo-frame>
{% endblock %}
