{% extends 'base.html.twig' %}

{% block title %}Kapo-Trainer – Guitorial{% endblock %}

{% block body %}
    <h1 class="font-display text-2xl font-semibold sm:text-3xl">Kapo-Trainer</h1>

    <section class="mt-6">
        <form method="post" action="{{ path('capo_trainer_settings') }}" data-turbo-frame="capo-trainer-practice" class="space-y-5">
            <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">

            <div>
                <h2 class="text-xs font-semibold uppercase tracking-wide text-base-content/50">Shapes</h2>
                <div class="mt-3 flex flex-wrap gap-2">
                    {% for id, shape in allShapes %}
                        <input type="checkbox" class="sr-only" id="shape-toggle-{{ id }}" name="shapes[]" value="{{ id }}" {{ id in activeShapes ? 'checked' : '' }}>
                        <label class="chip-toggle {{ shape.isMinor ? 'chip-toggle-minor' : '' }}" for="shape-toggle-{{ id }}">{{ id }}</label>
                    {% endfor %}
                </div>
            </div>

            <div>
                <h2 class="text-xs font-semibold uppercase tracking-wide text-base-content/50">Frage-Richtung</h2>
                <div class="mt-3 flex flex-wrap gap-2">
                    <input type="radio" class="sr-only" name="mode" id="mode-1" value="1" {{ mode == '1' ? 'checked' : '' }}>
                    <label class="chip-toggle" for="mode-1">Griffbild + Kapo → klingender Akkord</label>

                    <input type="radio" class="sr-only" name="mode" id="mode-2" value="2" {{ mode == '2' ? 'checked' : '' }}>
                    <label class="chip-toggle" for="mode-2">Zielakkord + Kapo → Griffbild</label>

                    <input type="radio" class="sr-only" name="mode" id="mode-3" value="3" {{ mode == '3' ? 'checked' : '' }}>
                    <label class="chip-toggle" for="mode-3">Griffbild + Zielakkord → Kapo-Bund</label>
                </div>
            </div>

            <div class="flex items-center gap-3">
                <label for="max_fret" class="text-sm text-base-content/60">Kapo-Bereich bis Bund</label>
                <input type="number" min="1" max="11" name="max_fret" id="max_fret" value="{{ maxFret }}" class="input input-sm input-bordered w-20 font-mono">
            </div>

            <button type="submit" class="btn btn-sm btn-neutral">Übernehmen</button>
        </form>
    </section>

    <turbo-frame id="capo-trainer-practice" class="mt-6 block">
        <section class="rounded-box border border-base-300 bg-base-200/60 p-6 sm:p-8">
            {% if mode == '1' %}
                <p class="text-sm text-base-content/60">Kapo im {{ fret }}. Bund, gegriffen wird {{ shapeId }}.</p>
                <p class="mt-2 font-display text-xl font-semibold sm:text-2xl">Welcher Akkord klingt wirklich?</p>
            {% elseif mode == '2' %}
                <p class="text-sm text-base-content/60">Kapo im {{ fret }}. Bund, du willst {{ sounding }} hören.</p>
                <p class="mt-2 font-display text-xl font-semibold sm:text-2xl">Welches Griffbild spielst du?</p>
            {% else %}
                <p class="text-sm text-base-content/60">Du greifst {{ shapeId }}, willst aber {{ sounding }} hören.</p>
                <p class="mt-2 font-display text-xl font-semibold sm:text-2xl">Auf welchen Bund kommt der Kapo?</p>
            {% endif %}

            {% if not answered %}
                <form method="post" action="{{ path('capo_trainer_answer') }}" class="mt-6">
                    <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">
                    <div class="grid grid-cols-3 gap-2 sm:grid-cols-4" data-controller="quiz">
                        {% for option in answerOptions %}
                            <button
                                    type="submit" name="guess" value="{{ option }}"
                                    class="answer-btn" data-quiz-target="answer" data-action="quiz#choose"
                            >{{ option }}</button>
                        {% endfor %}
                    </div>
                </form>
            {% else %}
                <div class="alert {{ correct ? 'alert-success' : 'alert-error' }} mt-6">
                    <span>
                        {% if correct %}
                            <strong>Richtig!</strong>
                        {% else %}
                            <strong>Leider falsch.</strong> Du hast <em>{{ guess }}</em> gewählt.
                        {% endif %}
                        Richtig wäre <strong>{{ expected }}</strong> gewesen
                        ({{ shapeId }} + Kapo {{ fret }} = {{ sounding }}).
                    </span>
                </div>
                <form method="post" action="{{ path('capo_trainer_next') }}" class="mt-4">
                    <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">
                    <button type="submit" class="btn btn-primary">Nächste Frage</button>
                </form>
            {% endif %}
        </section>

        <p class="mt-3 text-center font-mono text-sm text-base-content/50">
            {{ summary.correct }} / {{ summary.attempts }} richtig &middot; Serie: {{ summary.streak }}
        </p>
    </turbo-frame>
{% endblock %}
