{% extends 'base.html.twig' %}

{% block title %}{{ 'capo_trainer.title'|trans }} – Guitorial{% endblock %}

{% block body %}
    <a href="{{ path('home_index') }}" class="inline-flex items-center gap-1 text-sm text-base-content/60 hover:text-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M19 12H5M11 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {{ 'nav.back_home'|trans }}
    </a>

    <h1 class="font-display mt-3 text-2xl font-semibold sm:text-3xl">{{ 'capo_trainer.title'|trans }}</h1>

    <section class="mt-6">
        <form method="post" action="{{ path('capo_trainer_settings') }}" data-turbo-frame="capo-trainer-practice" class="space-y-5">
            <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">

            <div>
                <h2 class="text-xs font-semibold uppercase tracking-wide text-base-content/40">{{ 'capo_trainer.settings.shapes_label'|trans }}</h2>
                <div class="mt-3 flex flex-wrap gap-2">
                    {% for id, shape in allShapes %}
                        <input type="checkbox" class="sr-only" id="shape-toggle-{{ id }}" name="shapes[]" value="{{ id }}" {{ id in activeShapes ? 'checked' : '' }}>
                        <label class="chip-toggle {{ shape.isMinor ? 'chip-toggle-minor' : '' }}" for="shape-toggle-{{ id }}">{{ id }}</label>
                    {% endfor %}
                </div>
            </div>

            <div>
                <h2 class="text-xs font-semibold uppercase tracking-wide text-base-content/40">{{ 'capo_trainer.settings.mode_label'|trans }}</h2>
                <div class="mt-3 flex flex-wrap gap-2">
                    <input type="radio" class="sr-only" name="mode" id="mode-1" value="1" {{ mode == '1' ? 'checked' : '' }}>
                    <label class="chip-toggle" for="mode-1">{{ 'capo_trainer.settings.mode_1'|trans }}</label>

                    <input type="radio" class="sr-only" name="mode" id="mode-2" value="2" {{ mode == '2' ? 'checked' : '' }}>
                    <label class="chip-toggle" for="mode-2">{{ 'capo_trainer.settings.mode_2'|trans }}</label>

                    <input type="radio" class="sr-only" name="mode" id="mode-3" value="3" {{ mode == '3' ? 'checked' : '' }}>
                    <label class="chip-toggle" for="mode-3">{{ 'capo_trainer.settings.mode_3'|trans }}</label>
                </div>
            </div>

            <div class="flex items-center gap-3">
                <label for="max_fret" class="text-sm text-base-content/60">{{ 'capo_trainer.settings.max_fret_label'|trans }}</label>
                <input type="number" min="1" max="11" name="max_fret" id="max_fret" value="{{ maxFret }}" class="input input-sm input-bordered w-20 font-mono">
            </div>

            <button type="submit" class="btn btn-sm btn-neutral">{{ 'capo_trainer.settings.apply'|trans }}</button>
        </form>
    </section>

    <turbo-frame id="capo-trainer-practice" class="mt-4 block">
        {% if toast %}
            <div
                    class="toast toast-top toast-center z-50 pointer-events-none transition-opacity duration-300"
                    data-controller="toast"
            >
                <div class="alert {{ toast.correct ? 'alert-success' : 'alert-error' }} shadow-lg">
                    <span>
                        {% if toast.correct %}
                            {{ 'capo_trainer.practice.correct'|trans }}
                        {% else %}
                            {{ 'capo_trainer.practice.incorrect'|trans }}
                            {{ 'capo_trainer.practice.would_have_been'|trans({
                                '%expected%': toast.expected,
                                '%shape%': toast.shapeId,
                                '%fret%': toast.fret,
                                '%sounding%': toast.sounding,
                            }) }}
                        {% endif %}
                    </span>
                </div>
            </div>
        {% endif %}

        <section class="mt-12 text-center sm:mt-16">
            {% if mode == '1' %}
                <p class="text-xs uppercase tracking-widest text-base-content/40">{{ 'capo_trainer.practice.mode_1_hint'|trans({'%fret%': fret, '%shape%': shapeId}) }}</p>
                <p class="mt-3 font-display text-xl font-semibold sm:text-2xl">{{ 'capo_trainer.practice.mode_1_prompt'|trans }}</p>
            {% elseif mode == '2' %}
                <p class="text-xs uppercase tracking-widest text-base-content/40">{{ 'capo_trainer.practice.mode_2_hint'|trans({'%fret%': fret, '%sounding%': sounding}) }}</p>
                <p class="mt-3 font-display text-xl font-semibold sm:text-2xl">{{ 'capo_trainer.practice.mode_2_prompt'|trans }}</p>
            {% else %}
                <p class="text-xs uppercase tracking-widest text-base-content/40">{{ 'capo_trainer.practice.mode_3_hint'|trans({'%shape%': shapeId, '%sounding%': sounding}) }}</p>
                <p class="mt-3 font-display text-xl font-semibold sm:text-2xl">{{ 'capo_trainer.practice.mode_3_prompt'|trans }}</p>
            {% endif %}

            <form method="post" action="{{ path('capo_trainer_answer') }}" class="mt-10">
                <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">
                <div class="flex flex-wrap justify-center gap-1 sm:gap-2" data-controller="quiz">
                    {% for option in answerOptions %}
                        <button
                                type="submit" name="guess" value="{{ option }}"
                                class="answer-btn" data-quiz-target="answer" data-action="quiz#choose"
                        >{% if loop.index <= 10 %}<span class="keycap">{{ loop.index == 10 ? 0 : loop.index }}</span>{% endif %}{{ option }}</button>
                    {% endfor %}
                </div>
            </form>
        </section>

        <p class="mt-10 text-center font-mono text-sm text-base-content/40">
            {{ 'capo_trainer.practice.stats'|trans({'%correct%': summary.correct, '%attempts%': summary.attempts, '%streak%': summary.streak}) }}
        </p>
    </turbo-frame>
{% endblock %}
