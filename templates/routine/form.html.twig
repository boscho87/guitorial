{% extends 'base.html.twig' %}
{% import '_components/icons.html.twig' as icons %}

{% block title %}{{ (routine ? 'routine.edit.title' : 'routine.add.title')|trans }} – Guitorial{% endblock %}

{% block body %}
    <a href="{{ path('routine_index') }}" class="inline-flex items-center gap-1 text-sm text-base-content/70 hover:text-primary">
        {{ icons.icon('back') }}
        {{ 'routine.back_to_list'|trans }}
    </a>

    <h1 class="mt-3 font-display text-2xl font-semibold sm:text-3xl">{{ (routine ? 'routine.edit.title' : 'routine.add.title')|trans }}</h1>

    {% if routine %}
        {% if routine.shareToken %}
            <div class="stat-tile mt-3 flex flex-wrap items-center gap-2" data-controller="copy-link">
                <p class="text-sm text-base-content/70 shrink-0">{{ 'routine.share.label'|trans }}</p>
                <input
                        type="text" readonly value="{{ url('routine_shared_show', {token: routine.shareToken}) }}"
                        class="input input-bordered input-sm min-w-0 flex-1 font-mono text-xs"
                        data-copy-link-target="input"
                        data-action="click->copy-link#select"
                >
                <button type="button" class="btn btn-ghost btn-sm" data-copy-link-target="button" data-copy-link-confirmed-label="{{ 'routine.share.copied'|trans }}" data-action="copy-link#copy">{{ 'routine.share.copy'|trans }}</button>
            </div>
        {% else %}
            <form method="post" action="{{ path('routine_share', {id: routine.id}) }}" class="mt-3">
                <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">
                <button type="submit" class="btn btn-outline btn-sm">{{ icons.icon('share') }}{{ 'routine.share.button'|trans }}</button>
            </form>
        {% endif %}

        <div class="mt-6">
            <p class="text-sm font-medium">{{ 'routine.form.quick_add_label'|trans }}</p>
            <form method="post" action="{{ path('diary_add') }}" class="mt-2 flex items-center gap-1">
                <input type="hidden" name="_token" value="{{ csrf_token('diary') }}">
                <input type="hidden" name="return_to" value="routine_edit">
                <input type="hidden" name="return_to_id" value="{{ routine.id }}">
                <input type="text" name="title" maxlength="120" required placeholder="{{ 'routine.form.quick_add_placeholder'|trans }}" class="input input-sm input-bordered flex-1">
                <button type="submit" class="btn btn-primary btn-sm btn-square" title="{{ 'diary.add.new_button'|trans }}" aria-label="{{ 'diary.add.new_button'|trans }}">+</button>
            </form>
        </div>
    {% endif %}

    <form method="post" action="{{ routine ? path('routine_edit', {id: routine.id}) : path('routine_add') }}" class="mt-8">
        <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">

        <label class="block" data-hint-id="routines.name" data-hint="{{ 'hints.routines.name'|trans }}">
            <span class="text-sm font-medium">{{ 'routine.form.name'|trans }}</span>
            <input type="text" name="name" value="{{ routine ? routine.name : '' }}" maxlength="80" required class="input input-bordered mt-1 w-full">
        </label>

        <div class="mt-6" data-controller="routine-picker" data-hint-id="routines.pick" data-hint="{{ 'hints.routines.pick'|trans }}">
            <p class="text-sm font-medium">{{ 'routine.form.exercises'|trans }}</p>
            {% if availableExercises is empty and selectedExercises is empty %}
                <p class="mt-2 text-sm text-base-content/60">{{ 'routine.form.no_exercises'|trans }} <a href="{{ path('diary_add_form') }}" class="font-medium text-primary hover:underline">{{ 'routine.form.no_exercises_cta'|trans }}</a></p>
            {% else %}
                <p class="mt-1 text-xs text-base-content/50">{{ 'routine.form.drag_hint'|trans }}</p>
                <div class="mt-2 grid grid-cols-1 gap-4 sm:grid-cols-2">
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-wide text-base-content/50">{{ 'routine.form.available_heading'|trans }}</p>
                        <ul class="mt-2 flex min-h-32 flex-col gap-1.5 rounded-box border border-dashed border-base-300 p-2" data-routine-picker-target="available">
                            {% for entry in availableExercises %}
                                <li class="card-tile cursor-grab !p-2 text-sm active:cursor-grabbing" data-id="{{ entry.exercise.id }}">{{ entry.version.title }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-wide text-base-content/50" data-hint-id="routines.order" data-hint="{{ 'hints.routines.order'|trans }}">{{ 'routine.form.selected_heading'|trans }}</p>
                        <ul class="mt-2 flex min-h-32 flex-col gap-1.5 rounded-box border border-dashed border-primary/40 bg-primary/5 p-2" data-routine-picker-target="selected">
                            {% for entry in selectedExercises %}
                                <li class="card-tile cursor-grab !p-2 text-sm active:cursor-grabbing" data-id="{{ entry.exercise.id }}">{{ entry.version.title }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
                <div data-routine-picker-target="hiddenInputs"></div>
            {% endif %}
        </div>

        <button type="submit" class="btn btn-primary mt-6">{{ 'routine.form.save'|trans }}</button>
    </form>
{% endblock %}
