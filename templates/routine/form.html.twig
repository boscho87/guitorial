{% extends 'base.html.twig' %}
{% import '_components/icons.html.twig' as icons %}

{% block title %}{{ (routine ? 'routine.edit.title' : 'routine.add.title')|trans }} – Guitorial{% endblock %}

{% block body %}
    <a href="{{ path('routine_index') }}" class="inline-flex items-center gap-1 text-sm text-base-content/70 hover:text-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M19 12H5M11 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {{ 'routine.back_to_list'|trans }}
    </a>

    <h1 class="mt-3 font-display text-2xl font-semibold sm:text-3xl">{{ (routine ? 'routine.edit.title' : 'routine.add.title')|trans }}</h1>

    {% if routine %}
        {% if routine.shareToken %}
            <div class="mt-3 flex flex-wrap items-center gap-2 rounded-box border border-base-300 bg-base-200/40 px-4 py-2.5" data-controller="copy-link">
                <p class="text-sm text-base-content/70 shrink-0">{{ 'routine.share.label'|trans }}</p>
                <input
                        type="text" readonly value="{{ url('routine_shared_show', {token: routine.shareToken}) }}"
                        class="input input-bordered input-sm min-w-0 flex-1 font-mono text-xs"
                        data-copy-link-target="input"
                        data-action="click->copy-link#select"
                >
                <button type="button" class="btn btn-ghost btn-sm" data-action="copy-link#copy">{{ 'routine.share.copy'|trans }}</button>
            </div>
        {% else %}
            <form method="post" action="{{ path('routine_share', {id: routine.id}) }}" class="mt-3">
                <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">
                <button type="submit" class="btn btn-outline btn-sm">{{ icons.icon('share') }}{{ 'routine.share.button'|trans }}</button>
            </form>
        {% endif %}

        <section class="mt-8">
            <h2 class="text-xs font-semibold uppercase tracking-wide text-base-content/70">{{ 'routine.edit.order_heading'|trans }}</h2>
            {% if routine.items is empty %}
                <p class="mt-3 text-sm text-base-content/60">{{ 'routine.edit.no_items'|trans }}</p>
            {% else %}
                <ul class="mt-3 flex flex-col gap-2">
                    {% for item in routine.items %}
                        <li class="flex items-center justify-between gap-2 rounded-box border border-base-300 px-3 py-2">
                            <span class="text-sm">{{ itemTitles[item.id] }}</span>
                            <div class="flex shrink-0 gap-0.5">
                                <form method="post" action="{{ path('routine_item_move', {id: routine.id, itemId: item.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">
                                    <input type="hidden" name="direction" value="up">
                                    <button type="submit" class="btn btn-ghost btn-xs btn-square" title="{{ 'diary.groups.move_up'|trans }}" aria-label="{{ 'diary.groups.move_up'|trans }}">&uarr;</button>
                                </form>
                                <form method="post" action="{{ path('routine_item_move', {id: routine.id, itemId: item.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">
                                    <input type="hidden" name="direction" value="down">
                                    <button type="submit" class="btn btn-ghost btn-xs btn-square" title="{{ 'diary.groups.move_down'|trans }}" aria-label="{{ 'diary.groups.move_down'|trans }}">&darr;</button>
                                </form>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>
    {% endif %}

    <form method="post" action="{{ routine ? path('routine_edit', {id: routine.id}) : path('routine_add') }}" class="mt-8">
        <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">

        <label class="block">
            <span class="text-sm font-medium">{{ 'routine.form.name'|trans }}</span>
            <input type="text" name="name" value="{{ routine ? routine.name : '' }}" maxlength="80" required class="input input-bordered mt-1 w-full">
        </label>

        <div class="mt-6" data-controller="routine-picker">
            <p class="text-sm font-medium">{{ 'routine.form.exercises'|trans }}</p>
            {% if availableExercises is empty %}
                <p class="mt-2 text-sm text-base-content/60">{{ 'routine.form.no_exercises'|trans }} <a href="{{ path('diary_add_form') }}" class="font-medium text-primary hover:underline">{{ 'routine.form.no_exercises_cta'|trans }}</a></p>
            {% else %}
                <div class="mt-2 grid grid-cols-1 gap-4 sm:grid-cols-2">
                    <ul class="flex flex-col gap-1">
                        {% for entry in availableExercises %}
                            <li>
                                <label class="flex items-center gap-2 rounded-box px-2 py-1.5 hover:bg-base-200">
                                    <input
                                            type="checkbox" value="{{ entry.exercise.id }}" class="checkbox checkbox-sm"
                                            data-routine-picker-target="checkbox" data-action="change->routine-picker#toggle"
                                            data-label="{{ entry.version.title }}"
                                            {{ entry.exercise.id in selectedExerciseIds ? 'checked' : '' }}
                                    >
                                    <span class="text-sm">{{ entry.version.title }}</span>
                                </label>
                            </li>
                        {% endfor %}
                    </ul>
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-wide text-base-content/50">{{ 'routine.form.order_preview'|trans }}</p>
                        <div class="mt-2 text-sm text-base-content/70" data-routine-picker-target="preview"></div>
                    </div>
                </div>
                <div data-routine-picker-target="hiddenInputs"></div>
            {% endif %}
        </div>

        <button type="submit" class="btn btn-primary mt-6">{{ 'routine.form.save'|trans }}</button>
    </form>
{% endblock %}
