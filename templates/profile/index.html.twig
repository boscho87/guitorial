{% extends 'base.html.twig' %}
{% import '_components/icons.html.twig' as icons %}

{% block title %}{{ 'profile.title'|trans }} – Guitorial{% endblock %}

{% block meta_description %}{{ 'profile.meta_description'|trans }}{% endblock %}

{% block head_extra %}<meta name="robots" content="noindex">{% endblock %}

{% block body %}
    <a href="{{ path('diary_index') }}" class="inline-flex items-center gap-1 text-sm text-base-content/70 hover:text-primary">
        {{ icons.icon('back') }}
        {{ 'nav.back_home'|trans }}
    </a>

    <h1 class="font-display mt-3 text-2xl font-semibold sm:text-3xl">{{ 'profile.title'|trans }}</h1>
    <p class="mt-2 text-base-content/70">{{ 'profile.intro'|trans }}</p>

    <section class="mt-8" data-controller="theme">
        <h2 class="eyebrow">{{ 'profile.appearance.title'|trans }}</h2>
        <div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-4">
            {% for theme, labelKey in {
                'guitorial-light': 'nav.theme.light',
                'guitorial-dark': 'nav.theme.dark',
                'guitorial-slate': 'nav.theme.slate',
                'guitorial-contrast': 'nav.theme.contrast',
            } %}
                <button type="button" data-theme-name="{{ theme }}" data-action="theme#select" data-theme-target="option" class="card-tile flex items-center gap-2 !p-3 text-sm">
                    <span data-theme="{{ theme }}" class="h-4 w-4 shrink-0 rounded-full border border-base-300 bg-base-100"></span>
                    {{ labelKey|trans }}
                </button>
            {% endfor %}
        </div>
    </section>

    <section class="mt-10" data-controller="sort-setting">
        <h2 class="eyebrow">{{ 'profile.sort.title'|trans }}</h2>
        <div class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2" role="radiogroup" aria-label="{{ 'profile.sort.title'|trans }}">
            {% for value in ['custom', 'priority'] %}
                <label class="card-tile flex cursor-pointer items-start gap-3 !p-4 has-[:checked]:border-primary has-[:checked]:bg-primary/5">
                    <input type="radio" name="sort" value="{{ value }}" class="radio radio-primary radio-sm mt-0.5" data-sort-setting-target="option" data-action="change->sort-setting#change">
                    <span class="min-w-0">
                        <span class="block text-sm font-medium">{{ ('profile.sort.' ~ value ~ '.title')|trans }}</span>
                        <span class="mt-1 block text-xs text-base-content/60">{{ ('profile.sort.' ~ value ~ '.description')|trans }}</span>
                    </span>
                </label>
            {% endfor %}
        </div>
    </section>

    <section class="mt-10" data-controller="hints-settings" data-hints-settings-replayed-text-value="{{ 'profile.hints.replayed'|trans }}">
        <h2 class="eyebrow">{{ 'profile.hints.title'|trans }}</h2>
        <div class="card-tile mt-3 flex items-start justify-between gap-4 !p-4">
            <label class="min-w-0 flex-1 cursor-pointer" for="hints-enabled">
                <span class="block text-sm font-medium">{{ 'profile.hints.toggle'|trans }}</span>
                <span class="mt-1 block text-xs text-base-content/60">{{ 'profile.hints.description'|trans }}</span>
            </label>
            <input id="hints-enabled" type="checkbox" class="toggle toggle-primary" data-hints-settings-target="toggle" data-action="change->hints-settings#toggle">
        </div>
        <div class="mt-3 flex flex-wrap items-center gap-3">
            <button type="button" class="btn btn-outline btn-sm" data-action="hints-settings#replay">{{ 'profile.hints.replay'|trans }}</button>
            <span class="text-xs text-base-content/60" data-hints-settings-target="status" aria-live="polite"></span>
        </div>
    </section>

    {% if app.user %}
        <section class="mt-10">
            <h2 class="eyebrow">{{ 'profile.mail.title'|trans }}</h2>
            <form method="post" action="{{ path('profile_mail_preferences') }}" data-controller="auto-submit">
                <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">
                <div class="card-tile mt-3 flex items-start justify-between gap-4 !p-4">
                    <label class="min-w-0 flex-1 cursor-pointer" for="streak-reminders-enabled">
                        <span class="block text-sm font-medium">{{ 'profile.mail.streak_reminders.toggle'|trans }}</span>
                        <span class="mt-1 block text-xs text-base-content/60">{{ 'profile.mail.streak_reminders.description'|trans }}</span>
                    </label>
                    <input id="streak-reminders-enabled" type="checkbox" name="streak_reminders" value="1" class="toggle toggle-primary" {{ app.user.hasOptedOutOfStreakReminders ? '' : 'checked' }} data-action="change->auto-submit#submit">
                </div>
                <div class="card-tile mt-3 flex items-start justify-between gap-4 !p-4">
                    <label class="min-w-0 flex-1 cursor-pointer" for="daily-digest-enabled">
                        <span class="block text-sm font-medium">{{ 'profile.mail.daily_digest.toggle'|trans }}</span>
                        <span class="mt-1 block text-xs text-base-content/60">{{ 'profile.mail.daily_digest.description'|trans }}</span>
                    </label>
                    <input id="daily-digest-enabled" type="checkbox" name="daily_digest" value="1" class="toggle toggle-primary" {{ app.user.hasDailyDigestEnabled ? 'checked' : '' }} data-action="change->auto-submit#submit">
                </div>
            </form>
        </section>
    {% endif %}

    <section class="mt-10">
        <h2 class="eyebrow">{{ 'profile.account.title'|trans }}</h2>
        <div class="card-tile mt-3 flex flex-wrap items-center justify-between gap-3 !p-4">
            {% if app.user %}
                <p class="min-w-0 text-sm">
                    <span class="flex items-center gap-1.5 font-medium">
                        <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-success"></span>
                        {{ app.user.firstName }}
                    </span>
                    <span class="mt-0.5 block truncate text-xs text-base-content/60">{{ app.user.email }}</span>
                </p>
                <a href="{{ path('app_logout') }}" class="btn btn-ghost btn-sm text-error">{{ 'nav.logout'|trans }}</a>
            {% else %}
                <p class="text-sm text-base-content/70">{{ 'profile.account.anonymous'|trans }}</p>
                <a href="{{ path('app_login') }}" class="btn btn-outline btn-sm">{{ 'nav.login'|trans }}</a>
            {% endif %}
        </div>
    </section>
{% endblock %}
