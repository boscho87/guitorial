{% extends 'base.html.twig' %}

{% block title %}{{ 'history.title'|trans }} – Guitorial{% endblock %}

{% block body %}
    <a href="{{ path('home_index') }}" class="inline-flex items-center gap-1 text-sm text-base-content/70 hover:text-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M19 12H5M11 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {{ 'nav.back_home'|trans }}
    </a>

    <h1 class="font-display mt-3 text-2xl font-semibold sm:text-3xl">{{ 'history.title'|trans }}</h1>
    <p class="mt-2 text-base-content/70">{{ 'history.intro'|trans }}</p>

    {% if sessions is empty %}
        <p class="mt-10 text-sm text-base-content/60">{{ 'history.empty'|trans }}</p>
    {% else %}
        <div class="mt-8 space-y-2">
            {% for session in sessions %}
                <div class="flex items-center justify-between gap-4 rounded-box border border-base-300 bg-base-200/40 px-4 py-3">
                    <div>
                        <p class="font-medium">{{ session.title|trans }}</p>
                        <p class="mt-0.5 font-mono text-xs text-base-content/60">{{ session.startedAt|date('d.m.Y, H:i') }}</p>
                    </div>
                    <div class="text-right">
                        {% if session.finishedAt %}
                            {% if session.totalQuestions %}
                                <p class="font-mono text-sm font-semibold text-primary">{{ session.correctCount }}/{{ session.totalQuestions }}</p>
                            {% endif %}
                            <p class="text-xs text-base-content/60">{{ 'history.finished'|trans }}</p>
                        {% else %}
                            <p class="text-xs text-base-content/60">{{ 'history.in_progress'|trans({'%current%': session.questionIndex}) }}</p>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
