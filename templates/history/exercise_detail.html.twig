{% extends 'base.html.twig' %}
{% import '_components/confirm_modal.html.twig' as confirmModal %}
{% import '_components/icons.html.twig' as icons %}

{% block title %}{{ version ? version.title : 'exercise_session.untitled'|trans }} – Guitorial{% endblock %}

{% block body %}
    <a href="{{ path('history_groups') }}" class="inline-flex items-center gap-1 text-sm text-base-content/70 hover:text-primary">
        {{ icons.icon('back') }}
        {{ 'history.exercise_detail.back'|trans }}
    </a>

    <h1 class="font-display mt-3 text-2xl font-semibold sm:text-3xl">{{ version ? version.title : 'exercise_session.untitled'|trans }}</h1>

    {% if sessions is empty %}
        <p class="mt-10 text-sm text-base-content/60">{{ 'history.exercise_detail.empty'|trans }}</p>
    {% else %}
        <div class="mt-6 overflow-x-auto">
            <table class="table">
                <thead>
                    <tr class="text-xs uppercase tracking-wide text-base-content/70">
                        <th>{{ 'history.table.date'|trans }}</th>
                        <th class="text-right">{{ 'history.table.result'|trans }}</th>
                        <th class="text-right">{{ 'history.table.status'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for session in sessions %}
                        {% set previousSession = loop.index0 > 0 ? sessions[loop.index0 - 1] : null %}
                        {% if previousSession is null or session.startedAt|date('Y-m-d') != previousSession.startedAt|date('Y-m-d') %}
                            <tr>
                                <td colspan="3" class="pt-4 pb-1 text-xs font-semibold uppercase tracking-wide text-base-content/50">
                                    <a href="{{ path('diary_index', {datum: session.startedAt|date('Y-m-d')}) }}" class="hover:text-primary hover:underline">
                                        {{ session.startedAt|date('Y-m-d') == "now"|date('Y-m-d') ? 'diary.pager.today'|trans : session.startedAt|date('d.m.Y') }}
                                    </a>
                                </td>
                            </tr>
                        {% endif %}
                        <tr>
                            <td class="font-mono text-xs text-base-content/60">{{ session.startedAt|date('H:i') }}</td>
                            <td class="text-right font-mono text-sm font-semibold text-primary">
                                {% if session.totalQuestions %}{{ session.correctCount }}/{{ session.totalQuestions }}{% endif %}
                            </td>
                            <td class="text-right text-xs text-base-content/60">
                                {% if session.learningState %}
                                    {{ ('exercise_session.learning_state.' ~ session.learningState)|trans }}
                                {% elseif session.status == 'abgeschlossen' %}
                                    {{ 'history.finished'|trans }}
                                {% elseif session.status == 'verworfen' %}
                                    {{ 'history.discarded'|trans }}
                                {% else %}
                                    {{ 'history.in_progress'|trans({'%current%': session.questionIndex}) }}
                                {% endif %}
                            </td>
                        </tr>
                        {% if session.note %}
                            <tr>
                                <td colspan="3" class="pt-0 text-xs text-base-content/50">{{ session.note }}</td>
                            </tr>
                        {% endif %}
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <form id="exercise-history-delete" method="post" action="{{ path('history_exercise_delete', {id: exercise.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">
        </form>
        <div class="contents" data-controller="confirm-modal">
            <button type="button" class="btn btn-ghost btn-xs text-error mt-4" data-action="confirm-modal#open">{{ 'history.exercise_detail.delete'|trans }}</button>
            {{ confirmModal.dialog('exercise-history-delete', 'history.exercise_detail.delete_confirm'|trans, 'history.exercise_detail.delete'|trans) }}
        </div>
    {% endif %}
{% endblock %}
