{% extends 'base.html.twig' %}

{% block title %}{{ 'harmonic_function.meta_title'|trans }} – Guitorial{% endblock %}

{% block meta_description %}{{ 'harmonic_function.description'|trans }}{% endblock %}

{% block body %}
    <a href="{{ path('training_index') }}" class="inline-flex items-center gap-1 text-sm text-base-content/70 hover:text-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M19 12H5M11 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {{ 'nav.back_home'|trans }}
    </a>

    <h1 class="font-display mt-3 text-2xl font-semibold sm:text-3xl">{{ 'harmonic_function.title'|trans }}</h1>
    <p class="mt-2 text-base-content/70">{{ 'harmonic_function.settings.intro'|trans }}</p>

    <form
            method="post" action="{{ path('harmonic_function_start') }}" class="mt-8 space-y-6"
            data-controller="key-settings" data-key-settings-storage-key-value="guitorial:harmonic-function:settings"
    >
        <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">
        {% if planExerciseId %}
            <input type="hidden" name="uebung" value="{{ planExerciseId }}">
            <input type="hidden" name="ressource" value="{{ planResourceId }}">
        {% endif %}

        <div>
            <h2 class="text-xs font-semibold uppercase tracking-wide text-base-content/70">{{ 'harmonic_function.settings.presets_label'|trans }}</h2>
            <div class="mt-3 flex flex-wrap gap-2">
                <button type="button" class="btn btn-sm btn-ghost font-mono" data-action="key-settings#applyPreset" data-pairs="C-Dur,G-Dur,D-Dur,A-Dur,E-Dur,Am,Em,Bm,F#m,C#m">
                    {{ 'harmonic_function.settings.preset_common'|trans }}
                </button>
                <button type="button" class="btn btn-sm btn-ghost font-mono" data-action="key-settings#applyPreset" data-pairs="C-Dur,G-Dur,D-Dur,A-Dur,E-Dur,Am,Em,Bm,F#m,C#m,F-Dur,Bb-Dur,Eb-Dur,Dm,Gm,Cm">
                    {{ 'harmonic_function.settings.preset_extended'|trans }}
                </button>
                <button type="button" class="btn btn-sm btn-ghost font-mono" data-action="key-settings#applyPreset" data-pairs="{{ allKeys|keys|join(',') }}">
                    {{ 'harmonic_function.settings.preset_all'|trans }}
                </button>
            </div>
        </div>

        <details class="group rounded-box border border-base-300 px-4 py-3">
            <summary class="cursor-pointer text-xs font-semibold uppercase tracking-wide text-base-content/70 hover:text-primary">
                {{ 'harmonic_function.settings.customize_keys'|trans }}
            </summary>

            <div class="mt-4">
                <h2 class="text-xs font-semibold uppercase tracking-wide text-base-content/70">{{ 'harmonic_function.settings.major_group'|trans }}</h2>
                <div class="mt-3 flex flex-wrap gap-2">
                    {% for id, key in allKeys %}
                        {% if key.isMajor %}
                            <input
                                    type="checkbox" class="sr-only" id="hf-key-{{ id }}" name="keys[]" value="{{ id }}"
                                    {{ id in activeKeys ? 'checked' : '' }}
                                    data-key-settings-target="checkbox" data-action="change->key-settings#persist"
                            >
                            <label class="chip-toggle" for="hf-key-{{ id }}">{{ id }}</label>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>

            <div class="mt-4">
                <h2 class="text-xs font-semibold uppercase tracking-wide text-base-content/70">{{ 'harmonic_function.settings.minor_group'|trans }}</h2>
                <div class="mt-3 flex flex-wrap gap-2">
                    {% for id, key in allKeys %}
                        {% if not key.isMajor %}
                            <input
                                    type="checkbox" class="sr-only" id="hf-key-{{ id }}" name="keys[]" value="{{ id }}"
                                    {{ id in activeKeys ? 'checked' : '' }}
                                    data-key-settings-target="checkbox" data-action="change->key-settings#persist"
                            >
                            <label class="chip-toggle chip-toggle-minor" for="hf-key-{{ id }}">{{ id }}</label>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        </details>

        <div>
            <h2 class="text-xs font-semibold uppercase tracking-wide text-base-content/70">{{ 'harmonic_function.settings.mode_label'|trans }}</h2>
            <p class="mt-1 text-xs text-base-content/70">{{ 'harmonic_function.settings.mode_hint'|trans }}</p>
            <div class="mt-3 flex flex-wrap gap-2">
                <input
                        type="checkbox" class="sr-only" name="item_types[]" id="hf-type-chord" value="chord" {{ 'chord' in activeItemTypes ? 'checked' : '' }}
                        data-key-settings-target="checkbox" data-action="change->key-settings#persist"
                >
                <label class="chip-toggle" for="hf-type-chord">{{ 'harmonic_function.settings.mode_chord'|trans }}</label>

                <input
                        type="checkbox" class="sr-only" name="item_types[]" id="hf-type-note" value="note" {{ 'note' in activeItemTypes ? 'checked' : '' }}
                        data-key-settings-target="checkbox" data-action="change->key-settings#persist"
                >
                <label class="chip-toggle" for="hf-type-note">{{ 'harmonic_function.settings.mode_note'|trans }}</label>
            </div>
        </div>

        <div class="flex items-center gap-3">
            <label for="question_count" class="text-sm text-base-content/70">{{ 'harmonic_function.settings.question_count_label'|trans }}</label>
            <input
                    type="number" min="3" max="30" name="question_count" id="question_count"
                    value="{{ questionCount }}" class="input input-sm input-bordered w-20 font-mono"
                    data-key-settings-target="questionCount" data-action="input->key-settings#persist"
            >
        </div>

        <button type="submit" class="btn btn-primary">{{ 'harmonic_function.settings.continue'|trans }}</button>
    </form>
{% endblock %}
