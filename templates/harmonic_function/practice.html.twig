{% extends 'base.html.twig' %}

{% block title %}{{ 'harmonic_function.title'|trans }} – Guitorial{% endblock %}

{% block body %}
    <a href="{{ path('home_index') }}" class="inline-flex items-center gap-1 text-sm text-base-content/70 hover:text-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M19 12H5M11 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {{ 'nav.back_home'|trans }}
    </a>

    <turbo-frame id="harmonic-function-practice" class="mt-4 block">
        {% if not finished %}
            <div class="flex items-center justify-end gap-3 font-mono text-sm text-base-content/70">
                <span data-controller="timer" data-timer-start-value="{{ startedAtMs }}">0:00</span>
                <span>{{ 'harmonic_function.practice.question_progress'|trans({'%current%': questionIndex, '%total%': totalQuestions}) }}</span>
            </div>
        {% endif %}

        {% if toast %}
            <div
                    class="toast toast-top toast-center z-50 pointer-events-none transition-opacity duration-300"
                    data-controller="toast"
            >
                <div class="alert {{ toast.correct ? 'alert-success' : 'alert-error' }} shadow-lg">
                    <span>
                        {% if toast.correct %}
                            {{ 'harmonic_function.practice.correct'|trans }}
                        {% else %}
                            {{ 'harmonic_function.practice.incorrect'|trans }}
                            {{ 'harmonic_function.practice.your_guess'|trans({'%guess%': toast.guess}) }}
                        {% endif %}
                        {{ 'harmonic_function.practice.correct_is'|trans({'%item%': toast.itemLabel, '%roman%': toast.roman, '%key%': toast.keyId}) }}
                    </span>
                </div>
            </div>
        {% endif %}

        {% if finished %}
            <section class="mt-16 text-center sm:mt-24">
                <h2 class="text-xs uppercase tracking-widest text-base-content/70">{{ 'harmonic_function.summary.title'|trans }}</h2>
                <p class="mt-4 font-mono text-5xl font-semibold text-primary sm:text-6xl">
                    {{ 'harmonic_function.summary.result'|trans({'%correct%': correctCount, '%total%': totalQuestions}) }}
                </p>
                <p class="mt-2 font-mono text-sm text-base-content/70">
                    {{ 'harmonic_function.summary.time'|trans({'%time%': elapsedLabel}) }}
                </p>
                <div class="mt-10 flex flex-wrap justify-center gap-3">
                    <form method="post" action="{{ path('harmonic_function_restart') }}" data-controller="restart-shortcut">
                        <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">
                        <button type="submit" class="btn btn-primary">{{ 'harmonic_function.summary.restart'|trans }}</button>
                    </form>
                    <a href="{{ path('harmonic_function_settings') }}" class="btn btn-outline">{{ 'harmonic_function.summary.change_settings'|trans }}</a>
                </div>
            </section>
        {% else %}
            <section class="mt-16 text-center sm:mt-24">
                <p class="text-xs uppercase tracking-widest text-base-content/70">{{ 'harmonic_function.practice.key_context'|trans({'%key%': keyId}) }}</p>
                <p class="mt-4 font-mono text-4xl font-semibold sm:text-5xl">{{ itemLabel }}</p>
                <p class="mt-3 text-sm text-base-content/70">{{ 'harmonic_function.practice.prompt'|trans }}</p>

                <form method="post" action="{{ path('harmonic_function_answer') }}" class="mt-10">
                    <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">
                    <div class="flex flex-wrap justify-center gap-1 sm:gap-2" data-controller="quiz">
                        {% for roman in romanOptions %}
                            <button
                                    type="submit" name="guess" value="{{ roman }}"
                                    class="answer-btn" data-quiz-target="answer" data-action="quiz#choose"
                            >{% if loop.index <= 10 %}<span class="keycap">{{ loop.index == 10 ? 0 : loop.index }}</span>{% endif %}{{ roman }}</button>
                        {% endfor %}
                    </div>
                </form>
            </section>
        {% endif %}
    </turbo-frame>
{% endblock %}
