{% extends 'base.html.twig' %}
{% import '_components/icons.html.twig' as icons %}

{% block title %}Guitorial – {{ 'home.hero_title'|trans }}{% endblock %}

{% block meta_description %}{{ 'home.meta_description'|trans }}{% endblock %}

{% block body %}
    {% set toolIcons = {
        'tonart-erkennen': 'key',
        'kapo-trainer': 'capo',
        'funktion-bestimmen': 'steps',
        'griffbrett': 'fretboard-grid',
        'skalen-generator': 'dice',
    } %}

    <section class="relative overflow-hidden py-8 text-center sm:py-14">
        <svg class="pointer-events-none absolute left-1/2 top-0 -z-10 h-56 w-56 -translate-x-1/2 -translate-y-8 text-primary/10 sm:h-80 sm:w-80" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 4c-4 0-7.5 3-7.5 6.8 0 4.6 3.6 8.2 7.5 11.7 3.9-3.5 7.5-7.1 7.5-11.7C19.5 7 16 4 12 4Z"/>
        </svg>
        <h1 class="font-display text-4xl font-semibold sm:text-5xl">{{ 'home.hero_title'|trans }}</h1>
        <p class="mx-auto mt-4 max-w-md text-base-content/70 sm:text-lg">{{ 'home.hero_subtitle'|trans }}</p>
        <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
            <a href="#trainer" class="btn btn-primary">{{ 'home.hero_cta'|trans }}</a>
            <a href="{{ path('practice_guide_index') }}" class="btn btn-outline">{{ 'home.hero_secondary_cta'|trans }}</a>
        </div>
    </section>

    <section class="border-t border-base-300 py-10">
        <h2 class="text-center font-display text-2xl font-semibold">{{ 'home.benefits_title'|trans }}</h2>
        <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
            {% for icon, key in {
                'key': 'recall',
                'fretboard-grid': 'fretboard',
                'steps': 'weak_spots',
                'history': 'consistency',
                'unlock': 'progress',
            } %}
                <div class="flex items-start gap-3 rounded-box border border-base-300 bg-base-200/40 p-4">
                    <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-box bg-primary/10 text-primary">{{ icons.icon(icon) }}</span>
                    <div>
                        <p class="text-sm font-semibold">{{ ('home.benefit_' ~ key ~ '_title')|trans }}</p>
                        <p class="mt-1 text-sm text-base-content/70">{{ ('home.benefit_' ~ key ~ '_text')|trans }}</p>
                    </div>
                </div>
            {% endfor %}
        </div>
    </section>

    <section id="trainer" class="border-t border-base-300 py-12">
        <h2 class="text-center font-display text-2xl font-semibold">{{ 'home.trainer_title'|trans }}</h2>
        <p class="mx-auto mt-2 max-w-md text-center text-sm text-base-content/60">{{ 'home.trainer_bass_hint'|trans }}</p>
        <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2" data-controller="nav-shortcuts">
            {% for tool in tools %}
                <a
                        href="{{ path(tool.route) }}"
                        class="group relative flex flex-col justify-between rounded-box border border-base-300 bg-base-200/60 p-5 transition-all hover:-translate-y-0.5 hover:border-primary hover:shadow-lg sm:p-6"
                        data-nav-shortcuts-target="link"
                >
                    {% if loop.index <= 10 %}
                        <span class="absolute right-4 top-4 hidden font-mono text-xs text-base-content/35 sm:inline">{{ loop.index == 10 ? 0 : loop.index }}</span>
                    {% endif %}
                    <div>
                        <span class="inline-flex h-9 w-9 items-center justify-center rounded-box bg-primary/10 text-primary">
                            {{ icons.icon(toolIcons[tool.id]) }}
                        </span>
                        <h3 class="font-display mt-3 text-xl font-semibold">{{ tool.title|trans }}</h3>
                        <p class="mt-2 text-sm text-base-content/70">{{ tool.description|trans }}</p>
                    </div>
                    <span class="mt-5 inline-flex items-center gap-1 text-sm font-medium text-primary">
                        {{ 'home.cta'|trans }}
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" class="transition-transform group-hover:translate-x-1">
                            <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </span>
                </a>
            {% endfor %}
        </div>
    </section>

    <section class="border-t border-base-300 py-12">
        <div class="mx-auto max-w-xl text-center">
            <h2 class="font-display text-2xl font-semibold">{{ 'home.diary_title'|trans }}</h2>
            <p class="mt-3 text-base-content/70">{{ 'home.diary_text'|trans }}</p>
            <p class="mt-2 text-sm text-base-content/50">{{ 'home.diary_examples'|trans }}</p>
            <a href="{{ path('diary_index') }}" class="btn btn-outline mt-5">{{ 'home.diary_cta'|trans }}</a>
        </div>
    </section>

    <section class="border-t border-base-300 py-12">
        <div class="mx-auto max-w-xl text-center">
            <h2 class="font-display text-2xl font-semibold">{{ 'home.progress_title'|trans }}</h2>
            <p class="mt-3 text-base-content/70">{{ 'home.progress_text'|trans }}</p>
            <div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-3">
                <p class="stat-tile font-mono text-sm">{{ 'home.progress_example_streak'|trans }}</p>
                <p class="stat-tile font-mono text-sm">{{ 'home.progress_example_record'|trans }}</p>
                <p class="stat-tile font-mono text-sm">{{ 'home.progress_example_week'|trans }}</p>
            </div>
            <p class="mt-6 text-sm text-base-content/60">
                {{ 'home.storage_text'|trans }}
                {% if not app.user %}
                    <a href="{{ path('app_login') }}" class="font-medium text-primary hover:underline">{{ 'nav.login'|trans }}</a>
                {% endif %}
            </p>
        </div>
    </section>
{% endblock %}
