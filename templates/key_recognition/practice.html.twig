{% extends 'base.html.twig' %}

{% block title %}{{ 'key_recognition.title'|trans }} – Guitorial{% endblock %}

{% block body %}
    {% set hide_footer = true %}
    <a href="{{ path('home_index') }}" class="inline-flex items-center gap-1 text-sm text-base-content/70 hover:text-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M19 12H5M11 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {{ 'nav.back_home'|trans }}
    </a>

    {# The practice-sync controller must live on an element *inside* the turbo-frame, not on
       the frame itself: Turbo only swaps a frame's content on navigation, never its own
       attributes, so a controller on the <turbo-frame> tag would never reconnect and its
       data-*-value attributes would stay frozen at their first-load values forever. #}
    <turbo-frame id="key-recognition-practice" class="mt-4 block">
    <div
            data-controller="practice-sync" data-practice-sync-tool-value="tonart-erkennen"
            data-practice-sync-finished-value="{{ finished ? 'true' : 'false' }}"
            data-practice-sync-question-index-value="{{ questionIndex }}"
            data-practice-sync-total-questions-value="{{ totalQuestions }}"
            data-practice-sync-correct-count-value="{{ correctCount }}"
            data-practice-sync-session-id-value="{{ sessionId }}"
    >
        {% if not finished %}
            <div class="rounded-box bg-base-200/60 px-3 py-2">
                {% if timeProgress %}
                    <div
                            data-controller="timer" data-timer-start-value="{{ startedAtMs }}"
                            data-timer-progress-start-seconds-value="{{ timeProgress.todaySeconds }}"
                            data-timer-progress-label-template-value="{{ 'practice_progress.time_progress'|trans({'%minutes%': '{m}', '%target%': timeProgress.targetMinutes}) }}"
                    >
                        <progress
                                class="progress progress-primary h-1.5 w-full"
                                data-timer-target="progress"
                                value="{{ timeProgress.todaySeconds }}" max="{{ timeProgress.targetMinutes * 60 }}"
                                aria-label="{{ 'practice_progress.time_progress'|trans({'%minutes%': timeProgress.todayMinutes, '%target%': timeProgress.targetMinutes}) }}"
                        ></progress>
                        <div class="mt-2 flex items-center justify-between gap-3 font-mono text-sm text-base-content/70">
                            <span data-timer-target="progressLabel">{{ 'practice_progress.time_progress'|trans({'%minutes%': timeProgress.todayMinutes, '%target%': timeProgress.targetMinutes}) }}</span>
                            <span data-timer-target="clock">0:00</span>
                        </div>
                    </div>
                {% else %}
                    <progress
                            class="progress progress-primary h-1.5 w-full"
                            value="{{ questionIndex }}" max="{{ totalQuestions }}"
                            aria-label="{{ 'key_recognition.practice.question_progress'|trans({'%current%': questionIndex, '%total%': totalQuestions}) }}"
                    ></progress>
                    <div class="mt-2 flex items-center justify-between gap-3 font-mono text-sm text-base-content/70">
                        <span>{{ 'key_recognition.practice.question_progress'|trans({'%current%': questionIndex, '%total%': totalQuestions}) }}</span>
                        <span data-controller="timer" data-timer-start-value="{{ startedAtMs }}">0:00</span>
                    </div>
                {% endif %}
            </div>
        {% endif %}

        {{ include('practice/_toast.html.twig', {toast: toast}) }}

        {% if finished %}
            <section class="mt-16 animate-[question-in_0.25s_ease-out] text-center sm:mt-24">
                <h2 class="text-xs uppercase tracking-widest text-base-content/70">{{ 'key_recognition.summary.title'|trans }}</h2>
                <p class="mt-4 font-mono text-5xl font-semibold text-primary sm:text-6xl">
                    {{ 'key_recognition.summary.result'|trans({'%correct%': correctCount, '%total%': totalQuestions}) }}
                </p>
                <p class="mt-2 font-mono text-sm text-base-content/70">
                    {{ 'key_recognition.summary.time'|trans({'%time%': elapsedLabel}) }}
                </p>
                <div class="mt-10 flex flex-wrap justify-center gap-3">
                    <form method="post" action="{{ path('key_recognition_restart') }}" data-controller="restart-shortcut">
                        <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">
                        <button type="submit" class="btn btn-primary">{{ 'key_recognition.summary.restart'|trans }}</button>
                    </form>
                    <a href="{{ path('key_recognition_settings') }}" data-turbo-frame="_top" class="btn btn-outline">{{ 'key_recognition.summary.change_settings'|trans }}</a>
                    {% if promotable %}
                        <form method="post" action="{{ path('history_promote_to_exercise', {session: sessionId}) }}" data-turbo-frame="_top">
                            <input type="hidden" name="_token" value="{{ csrf_token('history') }}">
                            <button type="submit" class="btn btn-ghost">{{ 'history.promote.submit'|trans }}</button>
                        </form>
                    {% endif %}
                </div>
            </section>
        {% else %}
            <section class="mt-16 animate-[question-in_0.25s_ease-out] text-center sm:mt-24">
                <p class="text-xs uppercase tracking-widest text-base-content/70">{{ 'key_recognition.practice.prompt'|trans }}</p>
                <p class="mt-4 font-mono text-3xl font-semibold sm:text-5xl md:text-6xl">{{ progression|join(' – ') }}</p>

                <form method="post" action="{{ path('key_recognition_answer') }}" class="mt-12">
                    <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">
                    <div class="flex flex-wrap justify-center gap-1 sm:gap-2" data-controller="quiz" style="--answer-min-w: 12rem">
                        {% for option in answerOptions %}
                            <button
                                    type="submit" name="guess" value="{{ option.id }}"
                                    class="answer-btn" data-quiz-target="answer" data-action="quiz#choose"
                            ><span class="keycap">{{ loop.index == 10 ? 0 : loop.index }}</span>{{ option.label }}</button>
                        {% endfor %}
                    </div>
                </form>
            </section>
        {% endif %}
    </div>
    </turbo-frame>
{% endblock %}
