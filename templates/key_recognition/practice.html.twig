{% extends 'base.html.twig' %}

{% block title %}{{ 'key_recognition.title'|trans }} – Guitorial{% endblock %}

{% block body %}
    <a href="{{ path('home_index') }}" class="inline-flex items-center gap-1 text-sm text-base-content/60 hover:text-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M19 12H5M11 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {{ 'nav.back_home'|trans }}
    </a>

    <div class="mt-3 flex items-center justify-between">
        <h1 class="font-display text-2xl font-semibold sm:text-3xl">{{ 'key_recognition.title'|trans }}</h1>
        {% if not finished %}
            <span class="font-mono text-sm text-base-content/50">
                {{ 'key_recognition.practice.question_progress'|trans({'%current%': questionIndex, '%total%': totalQuestions}) }}
            </span>
        {% endif %}
    </div>

    {% if toast %}
        <div
                class="toast toast-top toast-center z-50 pointer-events-none transition-opacity duration-300"
                data-controller="toast"
        >
            <div class="alert {{ toast.correct ? 'alert-success' : 'alert-error' }} shadow-lg">
                <span>
                    {% if toast.correct %}
                        {{ 'key_recognition.practice.correct'|trans }}
                    {% else %}
                        {{ 'key_recognition.practice.incorrect'|trans }}
                        {{ 'key_recognition.practice.your_guess'|trans({'%guess%': toast.guessLabel}) }}
                        {{ 'key_recognition.practice.key_is'|trans }} <strong>{{ toast.correctLabel }}</strong>.
                    {% endif %}
                </span>
            </div>
        </div>
    {% endif %}

    <turbo-frame id="key-recognition-practice" class="mt-6 block">
        {% if finished %}
            <section class="rounded-box border border-base-300 bg-base-200/60 p-6 text-center sm:p-8">
                <h2 class="font-display text-xl font-semibold sm:text-2xl">{{ 'key_recognition.summary.title'|trans }}</h2>
                <p class="mt-3 font-mono text-3xl font-semibold text-primary">
                    {{ 'key_recognition.summary.result'|trans({'%correct%': correctCount, '%total%': totalQuestions}) }}
                </p>
                <div class="mt-6 flex flex-wrap justify-center gap-3">
                    <form method="post" action="{{ path('key_recognition_restart') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">
                        <button type="submit" class="btn btn-primary">{{ 'key_recognition.summary.restart'|trans }}</button>
                    </form>
                    <a href="{{ path('key_recognition_settings') }}" class="btn btn-outline">{{ 'key_recognition.summary.change_settings'|trans }}</a>
                </div>
            </section>
        {% else %}
            <section class="rounded-box border border-base-300 bg-base-200/60 p-6 sm:p-8">
                <p class="text-sm text-base-content/60">{{ 'key_recognition.practice.prompt'|trans }}</p>
                <p class="mt-2 font-mono text-2xl font-semibold sm:text-3xl">{{ progression|join(' – ') }}</p>

                <form method="post" action="{{ path('key_recognition_answer') }}" class="mt-6">
                    <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">
                    <div class="grid grid-cols-2 gap-2 sm:grid-cols-3" data-controller="quiz">
                        {% for pair in pairs %}
                            {% if pair.majorId in activePairs %}
                                <button
                                        type="submit" name="guess" value="{{ pair.majorId }}"
                                        class="answer-btn text-sm" data-quiz-target="answer" data-action="quiz#choose"
                                >{{ pair.label }}</button>
                            {% endif %}
                        {% endfor %}
                    </div>
                </form>
            </section>
        {% endif %}
    </turbo-frame>
{% endblock %}
