{% extends 'base.html.twig' %}
{% import '_components/icons.html.twig' as icons %}

{% block title %}{{ 'key_recognition.meta_title'|trans }} – Guitorial{% endblock %}

{% block meta_description %}{{ 'key_recognition.description'|trans }}{% endblock %}

{% block body %}
    <a href="{{ returnRouteId ? path('routine_show', {id: returnRouteId}) : path('training_index') }}" class="inline-flex items-center gap-1 text-sm text-base-content/70 hover:text-primary">
        {{ icons.icon('back') }}
        {{ 'nav.back_home'|trans }}
    </a>

    <h1 class="font-display mt-3 text-2xl font-semibold sm:text-3xl">{{ 'key_recognition.title'|trans }}</h1>
    <p class="mt-2 text-base-content/70">{{ 'key_recognition.settings.intro'|trans }}</p>

    <form
            method="post" action="{{ path('key_recognition_start') }}" class="mt-8 space-y-6"
            data-controller="key-settings submit-loading" data-action="submit->submit-loading#submit"
    >
        <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">
        {% if planExerciseId %}
            <input type="hidden" name="uebung" value="{{ planExerciseId }}">
            <input type="hidden" name="ressource" value="{{ planResourceId }}">
        {% endif %}
        {% if returnRouteId %}
            <input type="hidden" name="return_route" value="routine_show">
            <input type="hidden" name="return_route_id" value="{{ returnRouteId }}">
        {% endif %}

        {# C/G/D/A/E cover ~80% of guitar songs (open-chord keys); F/Bb/Eb are
           the next tier via barre chords; the rest (B/F#/Db/Ab) are rare
           without a capo. #}
        <div>
            <h2 class="eyebrow">{{ 'key_recognition.settings.presets_label'|trans }}</h2>
            <div class="mt-3 flex flex-wrap gap-2">
                <button type="button" class="btn btn-sm btn-ghost font-mono" data-action="key-settings#applyPreset" data-pairs="C-Dur,G-Dur,D-Dur,A-Dur,E-Dur">
                    {{ 'key_recognition.settings.preset_common'|trans }}
                </button>
                <button type="button" class="btn btn-sm btn-ghost font-mono" data-action="key-settings#applyPreset" data-pairs="C-Dur,G-Dur,D-Dur,A-Dur,E-Dur,F-Dur,Bb-Dur,Eb-Dur">
                    {{ 'key_recognition.settings.preset_extended'|trans }}
                </button>
                <button type="button" class="btn btn-sm btn-ghost font-mono" data-action="key-settings#applyPreset" data-pairs="{{ pairs|map(p => p.majorId)|join(',') }}">
                    {{ 'key_recognition.settings.preset_all'|trans }}
                </button>
            </div>
        </div>

        <div>
            <h2 class="eyebrow" data-hint="{{ 'hints.tool_settings.choose'|trans }}">{{ 'key_recognition.settings.keys_label'|trans }}</h2>
            <div class="mt-3 flex flex-wrap gap-2">
                {% for pair in pairs %}
                    <input
                            type="checkbox" class="sr-only" id="pair-toggle-{{ pair.majorId }}" name="pairs[]" value="{{ pair.majorId }}"
                            {{ pair.majorId in activePairs ? 'checked' : '' }}
                            data-key-settings-target="checkbox" data-action="change->key-settings#persist"
                    >
                    <label class="chip-toggle" for="pair-toggle-{{ pair.majorId }}">{{ pair.label }}</label>
                {% endfor %}
            </div>
        </div>

        <div class="flex items-center gap-3" data-hint="{{ 'hints.tool_settings.count'|trans }}">
            <label for="question_count" class="text-sm text-base-content/70">{{ 'key_recognition.settings.question_count_label'|trans }}</label>
            <input
                    type="number" min="3" max="30" name="question_count" id="question_count"
                    value="{{ questionCount }}" class="input input-sm input-bordered w-20 font-mono"
                    data-key-settings-target="questionCount" data-action="input->key-settings#persist"
            >
        </div>

        <button type="submit" class="btn btn-primary" data-hint="{{ 'hints.tool_settings.start'|trans }}">{{ 'key_recognition.settings.continue'|trans }}</button>
    </form>
{% endblock %}
