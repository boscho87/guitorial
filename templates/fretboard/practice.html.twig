{% extends 'base.html.twig' %}

{% block title %}{{ 'fretboard.title'|trans }} – Guitorial{% endblock %}

{% block body %}
    <a href="{{ path('home_index') }}" class="inline-flex items-center gap-1 text-sm text-base-content/70 hover:text-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M19 12H5M11 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {{ 'nav.back_home'|trans }}
    </a>

    {# The practice-sync controller must live on an element *inside* the turbo-frame, not on
       the frame itself: Turbo only swaps a frame's content on navigation, never its own
       attributes, so a controller on the <turbo-frame> tag would never reconnect and its
       data-*-value attributes would stay frozen at their first-load values forever. #}
    <turbo-frame id="fretboard-practice" class="mt-4 block">
    <div
            data-controller="practice-sync" data-practice-sync-tool-value="griffbrett"
            data-practice-sync-finished-value="{{ finished ? 'true' : 'false' }}"
            data-practice-sync-question-index-value="{{ questionIndex }}"
            data-practice-sync-total-questions-value="{{ totalQuestions }}"
            data-practice-sync-correct-count-value="{{ correctCount }}"
    >
        {% if not finished %}
            <div class="flex items-center justify-end gap-3 font-mono text-sm text-base-content/70">
                <span data-controller="timer" data-timer-start-value="{{ startedAtMs }}">0:00</span>
                <span>{{ 'fretboard.practice.question_progress'|trans({'%current%': questionIndex, '%total%': totalQuestions}) }}</span>
            </div>
        {% endif %}

        {{ include('practice/_toast.html.twig', {toast: toast}) }}

        {% if finished %}
            <section class="mt-16 text-center sm:mt-24">
                <h2 class="text-xs uppercase tracking-widest text-base-content/70">{{ 'fretboard.summary.title'|trans }}</h2>
                <p class="mt-4 font-mono text-5xl font-semibold text-primary sm:text-6xl">
                    {{ 'fretboard.summary.result'|trans({'%correct%': correctCount, '%total%': totalQuestions}) }}
                </p>
                <p class="mt-2 font-mono text-sm text-base-content/70">
                    {{ 'fretboard.summary.time'|trans({'%time%': elapsedLabel}) }}
                </p>
                <div class="mt-10 flex flex-wrap justify-center gap-3">
                    <form method="post" action="{{ path('fretboard_restart') }}" data-controller="restart-shortcut">
                        <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">
                        <button type="submit" class="btn btn-primary">{{ 'fretboard.summary.restart'|trans }}</button>
                    </form>
                    <a href="{{ path('fretboard_settings') }}" data-turbo-frame="_top" class="btn btn-outline">{{ 'fretboard.summary.change_settings'|trans }}</a>
                </div>
            </section>
        {% else %}
            <section class="mt-16 text-center sm:mt-24">
                {% if mode == 'note' %}
                    <p class="text-xs uppercase tracking-widest text-base-content/70">{{ 'fretboard.practice.mode_note_hint'|trans({'%string%': stringLabel, '%fret%': fret}) }}</p>
                    <p class="mt-3 text-sm text-base-content/70">{{ 'fretboard.practice.mode_note_prompt'|trans }}</p>
                {% elseif mode == 'string' %}
                    <p class="text-xs uppercase tracking-widest text-base-content/70">{{ 'fretboard.practice.mode_string_hint'|trans({'%fret%': fret, '%note%': note}) }}</p>
                    <p class="mt-3 text-sm text-base-content/70">{{ 'fretboard.practice.mode_string_prompt'|trans }}</p>
                {% else %}
                    <p class="text-xs uppercase tracking-widest text-base-content/70">{{ 'fretboard.practice.mode_fret_hint'|trans({'%string%': stringLabel, '%note%': note}) }}</p>
                    <p class="mt-3 text-sm text-base-content/70">{{ 'fretboard.practice.mode_fret_prompt'|trans }}</p>
                {% endif %}

                <form method="post" action="{{ path('fretboard_answer') }}" class="mt-10">
                    <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">
                    <div class="flex flex-wrap justify-center gap-1 sm:gap-2" data-controller="quiz">
                        {% for option in answerOptions %}
                            <button
                                    type="submit" name="guess" value="{{ option.value }}"
                                    class="answer-btn" data-quiz-target="answer" data-action="quiz#choose"
                            >{% if loop.index <= 10 %}<span class="keycap">{{ loop.index == 10 ? 0 : loop.index }}</span>{% endif %}{{ option.label }}</button>
                        {% endfor %}
                    </div>
                </form>
            </section>
        {% endif %}
    </div>
    </turbo-frame>
{% endblock %}
