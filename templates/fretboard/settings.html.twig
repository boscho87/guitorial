{% extends 'base.html.twig' %}

{% block title %}{{ 'fretboard.meta_title'|trans }} – Guitorial{% endblock %}

{% block meta_description %}{{ 'fretboard.description'|trans }}{% endblock %}

{% block body %}
    <a href="{{ returnRouteId ? path('routine_show', {id: returnRouteId}) : path('training_index') }}" class="inline-flex items-center gap-1 text-sm text-base-content/70 hover:text-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M19 12H5M11 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {{ 'nav.back_home'|trans }}
    </a>

    <h1 class="font-display mt-3 text-2xl font-semibold sm:text-3xl">{{ 'fretboard.title'|trans }}</h1>
    <p class="mt-2 text-base-content/70">{{ 'fretboard.settings.intro'|trans }}</p>

    <form
            method="post" action="{{ path('fretboard_start') }}" class="mt-8 space-y-6"
            data-controller="key-settings" data-key-settings-storage-key-value="guitorial:fretboard:settings"
    >
        <input type="hidden" name="_token" value="{{ csrf_token(csrfIntention) }}">
        {% if planExerciseId %}
            <input type="hidden" name="uebung" value="{{ planExerciseId }}">
            <input type="hidden" name="ressource" value="{{ planResourceId }}">
        {% endif %}
        {% if returnRouteId %}
            <input type="hidden" name="return_route" value="routine_show">
            <input type="hidden" name="return_route_id" value="{{ returnRouteId }}">
        {% endif %}

        <div>
            <h2 class="text-xs font-semibold uppercase tracking-wide text-base-content/70">{{ 'fretboard.settings.strings_label'|trans }}</h2>
            <div class="mt-3 flex flex-wrap gap-2">
                {% for number, string in allStrings %}
                    <input
                            type="checkbox" class="sr-only" id="fb-string-{{ number }}" name="strings[]" value="{{ number }}"
                            {{ number in activeStrings ? 'checked' : '' }}
                            data-key-settings-target="checkbox" data-action="change->key-settings#persist"
                    >
                    <label class="chip-toggle" for="fb-string-{{ number }}">{{ string.label }}</label>
                {% endfor %}
            </div>
        </div>

        <div>
            <h2 class="text-xs font-semibold uppercase tracking-wide text-base-content/70">{{ 'fretboard.settings.mode_label'|trans }}</h2>
            <p class="mt-1 text-xs text-base-content/70">{{ 'fretboard.settings.mode_hint'|trans }}</p>
            <div class="mt-3 flex flex-wrap gap-2">
                <input
                        type="checkbox" class="sr-only" name="modes[]" id="fb-mode-note" value="note" {{ 'note' in activeModes ? 'checked' : '' }}
                        data-key-settings-target="checkbox" data-action="change->key-settings#persist"
                >
                <label class="chip-toggle" for="fb-mode-note">{{ 'fretboard.settings.mode_note'|trans }}</label>

                <input
                        type="checkbox" class="sr-only" name="modes[]" id="fb-mode-string" value="string" {{ 'string' in activeModes ? 'checked' : '' }}
                        data-key-settings-target="checkbox" data-action="change->key-settings#persist"
                >
                <label class="chip-toggle" for="fb-mode-string">{{ 'fretboard.settings.mode_string'|trans }}</label>

                <input
                        type="checkbox" class="sr-only" name="modes[]" id="fb-mode-fret" value="fret" {{ 'fret' in activeModes ? 'checked' : '' }}
                        data-key-settings-target="checkbox" data-action="change->key-settings#persist"
                >
                <label class="chip-toggle" for="fb-mode-fret">{{ 'fretboard.settings.mode_fret'|trans }}</label>
            </div>
        </div>

        <div class="flex flex-wrap items-center gap-6">
            <div class="flex items-center gap-3">
                <label for="max_fret" class="text-sm text-base-content/70">{{ 'fretboard.settings.max_fret_label'|trans }}</label>
                <input type="number" min="1" max="24" name="max_fret" id="max_fret" value="{{ maxFret }}" class="input input-sm input-bordered w-20 font-mono">
            </div>
            <div class="flex items-center gap-3">
                <label for="question_count" class="text-sm text-base-content/70">{{ 'fretboard.settings.question_count_label'|trans }}</label>
                <input
                        type="number" min="3" max="30" name="question_count" id="question_count"
                        value="{{ questionCount }}" class="input input-sm input-bordered w-20 font-mono"
                        data-key-settings-target="questionCount" data-action="input->key-settings#persist"
                >
            </div>
        </div>

        <button type="submit" class="btn btn-primary">{{ 'fretboard.settings.continue'|trans }}</button>
    </form>
{% endblock %}
