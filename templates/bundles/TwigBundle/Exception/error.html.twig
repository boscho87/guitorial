{% extends 'base.html.twig' %}

{% block title %}{{ 'error.title'|trans }} – Guitorial{% endblock %}

{% block body %}
    <section class="mt-16 text-center sm:mt-24">
        <p class="text-xs uppercase tracking-widest text-base-content/70">{{ status_code|default(500) }}</p>
        <h1 class="font-display mt-4 text-2xl font-semibold sm:text-3xl">{{ 'error.title'|trans }}</h1>
        <p class="mt-3 text-base-content/70">{{ 'error.message'|trans }}</p>
        <a href="{{ path('home_index') }}" class="btn btn-primary mt-8">{{ 'error.back_home'|trans }}</a>
    </section>
{% endblock %}
