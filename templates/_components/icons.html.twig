{#
    Small inline SVG icons (16x16, stroke-based, matching the back-arrow
    icon already used throughout the app) - deliberately not an icon font,
    so there's no third-party request and nothing new to disclose in
    Datenschutz/Nutzungsbestimmungen.
#}
{% macro icon(name) %}
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        {% if name == 'history' %}
            <circle cx="12" cy="12" r="9"/>
            <path d="M12 7v5l3.5 2"/>
        {% elseif name == 'edit' %}
            <path d="M12 20h9"/>
            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5Z"/>
        {% elseif name == 'archive' %}
            <rect x="3" y="4" width="18" height="4" rx="1"/>
            <path d="M5 8v11a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8"/>
            <path d="M10 13h4"/>
        {% elseif name == 'trash' %}
            <path d="M4 7h16"/>
            <path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"/>
            <path d="M18 7l-1 13a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2L6 7"/>
            <path d="M10 11v6"/>
            <path d="M14 11v6"/>
        {% elseif name == 'reactivate' %}
            <path d="M3 12a9 9 0 1 0 3-6.7"/>
            <path d="M3 4v5h5"/>
        {% endif %}
    </svg>
{% endmacro %}
