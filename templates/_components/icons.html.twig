{#
    Small inline SVG icons (16x16, stroke-based, matching the back-arrow
    icon already used throughout the app) - deliberately not an icon font,
    so there's no third-party request and nothing new to disclose in
    Datenschutz/Nutzungsbestimmungen.
#}
{% macro icon(name) %}
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        {% if name == 'back' %}
            <path d="M19 12H5M11 18l-6-6 6-6"/>
        {% elseif name == 'metronome' %}
            <path d="M8 21h8l-2.2-16h-3.6L8 21Z"/>
            <path d="M12 16l4-8"/>
            <path d="M9.5 21h5"/>
        {% elseif name == 'history' %}
            <circle cx="12" cy="12" r="9"/>
            <path d="M12 7v5l3.5 2"/>
        {% elseif name == 'edit' %}
            <path d="M12 20h9"/>
            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5Z"/>
        {% elseif name == 'archive' %}
            <rect x="3" y="4" width="18" height="4" rx="1"/>
            <path d="M5 8v11a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8"/>
            <path d="M10 13h4"/>
        {% elseif name == 'trash' %}
            <path d="M4 7h16"/>
            <path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"/>
            <path d="M18 7l-1 13a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2L6 7"/>
            <path d="M10 11v6"/>
            <path d="M14 11v6"/>
        {% elseif name == 'reactivate' %}
            <path d="M3 12a9 9 0 1 0 3-6.7"/>
            <path d="M3 4v5h5"/>
        {% elseif name == 'play' %}
            <path d="M7 4.5v15l13-7.5Z" fill="currentColor" stroke="none"/>
        {% elseif name == 'pause' %}
            <path d="M8 5v14M16 5v14" stroke-width="3"/>
        {% elseif name == 'external' %}
            <path d="M14 4h6v6"/>
            <path d="M20 4l-9 9"/>
            <path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>
        {% elseif name == 'user' %}
            <circle cx="12" cy="8" r="4"/>
            <path d="M4 21a8 8 0 0 1 16 0"/>
        {% elseif name == 'help' %}
            <circle cx="12" cy="12" r="9"/>
            <path d="M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.7.4-1 .9-1 1.7"/>
            <path d="M12 17h.01" stroke-width="3"/>
        {% elseif name == 'close' %}
            <path d="M6 6l12 12M18 6L6 18"/>
        {% elseif name == 'key' %}
            <circle cx="7" cy="15" r="4"/>
            <path d="M10 12l10-10"/>
            <path d="M17 5l2 2"/>
            <path d="M14 8l2 2"/>
        {% elseif name == 'capo' %}
            <rect x="4" y="10" width="16" height="4" rx="2"/>
            <path d="M4 10V7a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v3"/>
        {% elseif name == 'steps' %}
            <path d="M4 20v-4h4v-4h4v-4h4v-4h4"/>
        {% elseif name == 'fretboard-grid' %}
            <path d="M4 4v16M9 4v16M14 4v16M19 4v16"/>
            <path d="M4 8h16M4 13h16M4 18h16"/>
        {% elseif name == 'unlock' %}
            <path d="M8 11V7a4 4 0 0 1 7.5-2"/>
            <rect x="5" y="11" width="14" height="10" rx="2"/>
        {% elseif name == 'share' %}
            <circle cx="18" cy="5" r="3"/>
            <circle cx="6" cy="12" r="3"/>
            <circle cx="18" cy="19" r="3"/>
            <path d="M8.6 10.5l6.8-3.9"/>
            <path d="M8.6 13.5l6.8 3.9"/>
        {% elseif name == 'dice' %}
            <rect x="4" y="4" width="16" height="16" rx="3"/>
            <circle cx="9" cy="9" r="1" fill="currentColor" stroke="none"/>
            <circle cx="15" cy="9" r="1" fill="currentColor" stroke="none"/>
            <circle cx="9" cy="15" r="1" fill="currentColor" stroke="none"/>
            <circle cx="15" cy="15" r="1" fill="currentColor" stroke="none"/>
            <circle cx="12" cy="12" r="1" fill="currentColor" stroke="none"/>
        {% endif %}
    </svg>
{% endmacro %}
