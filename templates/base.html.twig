<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Guitorial{% endblock %}</title>

    {% block stylesheets %}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,500&family=Work+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
    {% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body class="flex min-h-screen flex-col bg-base-100 text-base-content">
<header class="border-b border-base-300">
    <nav class="mx-auto flex max-w-3xl items-center px-4 py-4 sm:px-6">
        <a class="font-display flex items-center gap-2 text-lg font-semibold" href="{{ path('home_index') }}">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" class="text-primary">
                <path d="M12 3c-1 3-4 4-4 8a4 4 0 0 0 8 0c0-4-3-5-4-8Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                <path d="M12 15v6M9 21h6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            </svg>
            Guitorial
        </a>
    </nav>
</header>
<main class="mx-auto w-full max-w-3xl flex-grow px-4 py-6 sm:px-6 sm:py-10">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} mb-4">{{ message }}</div>
        {% endfor %}
    {% endfor %}
    {% block body %}{% endblock %}
</main>
<footer class="border-t border-base-300 py-5 text-center text-sm text-base-content/60">
    Guitorial &ndash; Tonarten &amp; Akkorde üben
</footer>
</body>
</html>
