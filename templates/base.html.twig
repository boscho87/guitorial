<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Guitorial{% endblock %}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">

    {% block stylesheets %}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,500&family=Work+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
    {% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body class="flex min-h-screen flex-col text-base-content">
<header class="border-b border-base-300">
    <nav class="mx-auto flex max-w-3xl items-center justify-between px-4 py-4 sm:px-6">
        <a class="font-display flex items-center gap-2 text-lg font-semibold" href="{{ path('home_index') }}">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="text-primary">
                <path d="M12 4c-4 0-7.5 3-7.5 6.8 0 4.6 3.6 8.2 7.5 11.7 3.9-3.5 7.5-7.1 7.5-11.7C19.5 7 16 4 12 4Z"/>
            </svg>
            Guitorial
        </a>
        <a href="{{ path('history_index') }}" class="text-sm text-base-content/70 hover:text-primary">{{ 'nav.history'|trans }}</a>
    </nav>
</header>
<main class="mx-auto w-full max-w-3xl flex-grow px-4 py-6 sm:px-6 sm:py-10">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} mb-4">{{ message }}</div>
        {% endfor %}
    {% endfor %}
    {% block body %}{% endblock %}
</main>
<footer class="mt-auto border-t border-primary/20 bg-footer text-footer-content">
    <div class="mx-auto flex max-w-3xl flex-col items-center gap-1 px-4 py-6 text-center sm:px-6">
        <p class="font-display text-sm font-medium">Guitorial <span class="text-footer-content/40">&ndash;</span> {{ 'app.tagline'|trans }}</p>
        <p class="text-xs text-footer-content/50">
            &copy; {{ "now"|date("Y") }} itscoding / <a href="mailto:simon.d.mueller@itscoding.ch" class="underline decoration-footer-content/30 underline-offset-2 transition-colors hover:text-primary hover:decoration-primary">boscho87</a>
        </p>
    </div>
</footer>
</body>
</html>
