<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <script>
        (function () {
            var t = localStorage.getItem('guitorial_theme');
            if (t) document.documentElement.dataset.theme = t;
        })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Guitorial{% endblock %}</title>
    <meta name="description" content="{% block meta_description %}Guitorial hilft dir, Musiktheorie und Gitarrenspiel gezielt zu üben – Tonarten, Akkordfunktionen, Griffbrett und mehr, mit Verlauf und Übetagebuch.{% endblock %}">
    {% block robots %}{% endblock %}
    <meta name="theme-color" content="#a8752e">
    <link rel="manifest" href="/manifest.webmanifest">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="Guitorial">
    <link rel="apple-touch-icon" href="/favicon.svg">
    <link rel="canonical" href="{{ app.request.uri }}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Guitorial">
    <meta property="og:title" content="{{ block('title') }}">
    <meta property="og:description" content="{{ block('meta_description') }}">
    <meta property="og:url" content="{{ app.request.uri }}">
    <meta property="og:image" content="{{ absolute_url('/og-image.png') }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ block('title') }}">
    <meta name="twitter:description" content="{{ block('meta_description') }}">
    <meta name="twitter:image" content="{{ absolute_url('/og-image.png') }}">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">

    {% block stylesheets %}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,500&family=Work+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
    {% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
    {% block head_extra %}{% endblock %}
</head>
<body class="flex min-h-screen flex-col text-base-content" data-controller="hints" data-hints-page-value="{{ app.request.attributes.get('_route') }}" data-hints-labels-value="{{ {next: 'hints.ui.next'|trans, back: 'hints.ui.back'|trans, done: 'hints.ui.done'|trans, skip: 'hints.ui.skip'|trans, disable: 'hints.ui.disable'|trans, of: 'hints.ui.of'|trans}|json_encode|e('html_attr') }}">
{% import '_components/icons.html.twig' as icons %}
{% set currentRoute = app.request.attributes.get('_route') %}
{% set isProfileActive = currentRoute == 'profile_index' %}
{% set isStartActive = currentRoute == 'home_index' %}
{% set isToolsActive = currentRoute == 'training_index'
    or currentRoute starts with 'key_recognition_'
    or currentRoute starts with 'capo_trainer_'
    or currentRoute starts with 'harmonic_function_'
    or currentRoute starts with 'fretboard_'
    or currentRoute starts with 'scale_generator_' %}
{% set isMyExercisesActive = currentRoute starts with 'diary_'
    or currentRoute starts with 'history_'
    or currentRoute starts with 'routine_'
    or currentRoute starts with 'exercise_session_'
    or currentRoute == 'progress_index' %}
{% set isTipsActive = currentRoute == 'practice_guide_index' %}
<header class="relative border-b border-base-300 {{ hideChromeOnMobile is defined and hideChromeOnMobile ? 'hidden sm:block' : '' }}" data-controller="nav-menu">
    <div class="mx-auto flex max-w-3xl items-center justify-between gap-2 px-4 py-3 sm:px-6 sm:py-4">
        <a class="font-display flex items-center gap-2 text-lg font-semibold" href="{{ path(app.user ? 'diary_index' : 'home_index') }}">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="text-primary">
                <path d="M12 4c-4 0-7.5 3-7.5 6.8 0 4.6 3.6 8.2 7.5 11.7 3.9-3.5 7.5-7.1 7.5-11.7C19.5 7 16 4 12 4Z"/>
            </svg>
            Guitorial
        </a>
        <nav class="hidden items-center gap-x-1 gap-y-1.5 text-sm sm:flex">
            {# Same "current page" idiom as the mobile drawer below
               (background pill + primary color), not just a color swap -
               the two used to disagree on how "active" looks. #}
            <a href="{{ path('home_index') }}" class="rounded-box px-2.5 py-1.5 transition-colors {{ isStartActive ? 'bg-base-200 font-medium text-primary' : 'text-base-content/70 hover:bg-base-200/60 hover:text-primary' }}" {% if isStartActive %}aria-current="page"{% endif %}>{{ 'nav.start'|trans }}</a>
            <a href="{{ path('training_index') }}" class="rounded-box px-2.5 py-1.5 transition-colors {{ isToolsActive ? 'bg-base-200 font-medium text-primary' : 'text-base-content/70 hover:bg-base-200/60 hover:text-primary' }}" {% if isToolsActive %}aria-current="page"{% endif %}>{{ 'nav.training'|trans }}</a>
            <a href="{{ path('diary_index') }}" class="rounded-box px-2.5 py-1.5 transition-colors {{ isMyExercisesActive ? 'bg-base-200 font-medium text-primary' : 'text-base-content/70 hover:bg-base-200/60 hover:text-primary' }}" {% if isMyExercisesActive %}aria-current="page"{% endif %}>{{ 'nav.diary'|trans }}</a>
            <a href="{{ path('practice_guide_index') }}" class="rounded-box px-2.5 py-1.5 transition-colors {{ isTipsActive ? 'bg-base-200 font-medium text-primary' : 'text-base-content/70 hover:bg-base-200/60 hover:text-primary' }}" {% if isTipsActive %}aria-current="page"{% endif %}>{{ 'nav.practice_guide'|trans }}</a>
            <div class="flex items-center gap-4 border-l border-primary/30 pl-4">
                {% if app.user %}
                    <span class="inline-flex items-center gap-1.5 font-medium text-base-content/90" title="{{ 'nav.logged_in_as'|trans({'%email%': app.user.email}) }}">
                        <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-success"></span>
                        {{ app.user.firstName }}
                    </span>
                    <a href="{{ path('app_logout') }}" class="text-base-content/70 hover:text-error">{{ 'nav.logout'|trans }}</a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="inline-flex items-center gap-1.5 text-base-content/70 hover:text-primary">
                        <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-base-content/25"></span>
                        {{ 'nav.login'|trans }}
                    </a>
                {% endif %}
            </div>
        </nav>
        <div class="hidden items-center gap-0.5 sm:flex">
            {# Shown by hints_controller.js only when hints are on and this
               page actually has some. #}
            <button type="button" class="btn btn-ghost btn-sm btn-circle hidden text-base-content/70" data-hints-target="helpButton" data-action="hints#start" title="{{ 'nav.hints_show'|trans }}" aria-label="{{ 'nav.hints_show'|trans }}">{{ icons.icon('help') }}</button>
            <a href="{{ path('profile_index') }}" class="btn btn-ghost btn-sm btn-circle {{ isProfileActive ? 'bg-base-200 text-primary' : 'text-base-content/70' }}" title="{{ 'nav.profile'|trans }}" aria-label="{{ 'nav.profile'|trans }}" {% if isProfileActive %}aria-current="page"{% endif %}>{{ icons.icon('user') }}</a>
        </div>
        <button
                type="button" class="-mr-2 inline-flex items-center justify-center rounded-box p-2 text-base-content/70 hover:bg-base-200 sm:hidden"
                data-action="nav-menu#toggle" data-nav-menu-target="button"
                aria-expanded="false" aria-controls="mobile-nav-panel" aria-label="{{ 'nav.menu_open'|trans }}"
        >
            <svg data-nav-menu-target="openIcon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
            <svg data-nav-menu-target="closeIcon" class="hidden" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
    </div>
    <div
            id="mobile-nav-panel" data-nav-menu-target="panel"
            class="fixed inset-0 z-50 hidden flex-col bg-base-100 sm:hidden"
            data-action="keydown.esc->nav-menu#close"
    >
        <div class="flex items-center justify-between border-b border-base-300 px-4 py-3">
            <span class="font-display text-lg font-semibold">Guitorial</span>
            <button type="button" class="-mr-2 inline-flex items-center justify-center rounded-box p-2 text-base-content/70 hover:bg-base-200" data-action="nav-menu#close" aria-label="{{ 'nav.menu_close'|trans }}">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
            </button>
        </div>
        <nav class="flex flex-1 flex-col gap-1 overflow-y-auto p-3 text-base">
            <a href="{{ path('home_index') }}" class="rounded-box px-4 py-3 {{ isStartActive ? 'bg-base-200 font-medium text-primary' : 'text-base-content/80 hover:bg-base-200 active:bg-base-200' }}" {% if isStartActive %}aria-current="page"{% endif %}>{{ 'nav.start'|trans }}</a>
            <a href="{{ path('training_index') }}" class="rounded-box px-4 py-3 {{ isToolsActive ? 'bg-base-200 font-medium text-primary' : 'text-base-content/80 hover:bg-base-200 active:bg-base-200' }}" {% if isToolsActive %}aria-current="page"{% endif %}>{{ 'nav.training'|trans }}</a>
            <a href="{{ path('diary_index') }}" class="rounded-box px-4 py-3 {{ isMyExercisesActive ? 'bg-base-200 font-medium text-primary' : 'text-base-content/80 hover:bg-base-200 active:bg-base-200' }}" {% if isMyExercisesActive %}aria-current="page"{% endif %}>{{ 'nav.diary'|trans }}</a>
            <a href="{{ path('practice_guide_index') }}" class="rounded-box px-4 py-3 {{ isTipsActive ? 'bg-base-200 font-medium text-primary' : 'text-base-content/80 hover:bg-base-200 active:bg-base-200' }}" {% if isTipsActive %}aria-current="page"{% endif %}>{{ 'nav.practice_guide'|trans }}</a>
            <a href="{{ path('profile_index') }}" class="rounded-box px-4 py-3 {{ isProfileActive ? 'bg-base-200 font-medium text-primary' : 'text-base-content/80 hover:bg-base-200 active:bg-base-200' }}" {% if isProfileActive %}aria-current="page"{% endif %}>{{ 'nav.profile'|trans }}</a>
            <button type="button" class="hidden rounded-box px-4 py-3 text-left text-base-content/80 hover:bg-base-200 active:bg-base-200" data-hints-target="helpButton" data-action="hints#start nav-menu#close">{{ 'nav.hints_show'|trans }}</button>
            <div class="mt-2 border-t border-base-300 pt-2">
                {% if app.user %}
                    <span class="flex items-center gap-1.5 px-4 py-2 font-medium text-base-content/90">
                        <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-success"></span>
                        {{ app.user.firstName }}
                    </span>
                    <a href="{{ path('app_logout') }}" class="block rounded-box px-4 py-3 text-error hover:bg-base-200 active:bg-base-200">{{ 'nav.logout'|trans }}</a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="flex items-center gap-1.5 rounded-box px-4 py-3 text-base-content/80 hover:bg-base-200 active:bg-base-200">
                        <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-base-content/25"></span>
                        {{ 'nav.login'|trans }}
                    </a>
                {% endif %}
            </div>
        </nav>
    </div>
</header>
<main class="mx-auto w-full max-w-3xl flex-grow px-4 py-6 sm:px-6 sm:py-10 {{ hideChromeOnMobile is defined and hideChromeOnMobile ? 'max-sm:flex max-sm:min-h-dvh max-sm:flex-col max-sm:justify-center max-sm:py-4' : '' }}">
    {# Explicit type list on purpose - frame_toast is a separate bucket
       read inside frame-scoped content instead (see _frame_toast.html.twig),
       so a frame-scoped navigation (whose response discards everything
       outside the matching turbo-frame) doesn't have this block silently
       consume-and-drop it first. Floating + auto-dismissing, same
       bottom-toast treatment as _frame_toast.html.twig, rather than an
       inline banner that shifted the page layout and never went away on
       its own. #}
    {% set flashes = app.flashes(['success', 'error', 'info']) %}
    {% if flashes is not empty %}
        <div class="fixed inset-x-0 bottom-4 z-50 flex flex-col items-center gap-2 pointer-events-none px-4" data-controller="toast">
            {% for label, messages in flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label }} animate-[toast-in-bottom_0.25s_ease-out]">{{ message|trans }}</div>
                {% endfor %}
            {% endfor %}
        </div>
    {% endif %}
    {% block body %}{% endblock %}
</main>
{% if hidePracticeTools is not defined or not hidePracticeTools %}
    <div class="contents">{% include '_components/practice_tools.html.twig' %}</div>
{% endif %}
{% if hide_footer is not defined or not hide_footer %}
<footer class="mt-auto border-t border-primary/20 bg-footer text-footer-content {{ hideChromeOnMobile is defined and hideChromeOnMobile ? 'hidden sm:block' : '' }}">
    <div class="mx-auto flex max-w-3xl flex-col items-center gap-2 px-4 py-5 text-center sm:px-6">
        <p class="text-xs text-footer-content/50">
            <span class="font-display font-medium text-footer-content/70">Guitorial</span> &ndash; {{ 'app.tagline'|trans }}
            &middot; &copy; {{ "now"|date("Y") }} <a href="mailto:simon.d.mueller@itscoding.ch" class="underline decoration-footer-content/30 underline-offset-2 transition-colors hover:text-primary hover:decoration-primary">boscho87</a>
            &middot; v{{ app_version }}
        </p>
        <nav class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1.5 text-xs text-footer-content/50">
            <a href="{{ path('privacy_index') }}" class="underline decoration-footer-content/30 underline-offset-2 transition-colors hover:text-primary hover:decoration-primary">{{ 'footer.privacy'|trans }}</a>
            <a href="{{ path('imprint_index') }}" class="underline decoration-footer-content/30 underline-offset-2 transition-colors hover:text-primary hover:decoration-primary">{{ 'footer.imprint'|trans }}</a>
            <a href="{{ path('terms_index') }}" class="underline decoration-footer-content/30 underline-offset-2 transition-colors hover:text-primary hover:decoration-primary">{{ 'footer.terms'|trans }}</a>
            <a href="https://github.com/boscho87/guitorial" target="_blank" rel="noopener" class="underline decoration-footer-content/30 underline-offset-2 transition-colors hover:text-primary hover:decoration-primary">{{ 'footer.github'|trans }}</a>
            <a href="https://github.com/boscho87/guitorial/issues/new?template=feature_request.yml" target="_blank" rel="noopener" class="underline decoration-footer-content/30 underline-offset-2 transition-colors hover:text-primary hover:decoration-primary">{{ 'footer.feature_request'|trans }}</a>
        </nav>
    </div>
</footer>
{% endif %}
<script>
    if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
            navigator.serviceWorker.register('/sw.js');
        });
    }
</script>
</body>
</html>
